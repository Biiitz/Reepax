<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:Reepax.Helpers">
    <Style TargetType="ContextMenu">
        <Setter Property="helpers:PopupMorph.IsEnabled" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <helpers:MorphingPopupBorder Style="{StaticResource PopupSurfaceStyle}" Padding="5">
                        <ItemsPresenter MinWidth="248" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </helpers:MorphingPopupBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="9,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource CompactCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ItemIcon" ContentSource="Icon"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="CheckMark" Data="{DynamicResource IconCheck}"
                                      Fill="{DynamicResource AccentBlueBrush}" Width="12" Height="12"
                                      Stretch="Uniform" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  Margin="10,0,12,0" VerticalAlignment="Center" />
                                <Path x:Name="SubmenuArrow" Grid.Column="2" Data="{DynamicResource IconChevronRight}"
                                      Fill="{DynamicResource TextSecondaryBrush}" Width="10" Height="10"
                                      Stretch="Uniform" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup helpers:PopupMorph.IsEnabled="True" x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-8"
                               PlacementTarget="{Binding ElementName=ItemSurface}"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <helpers:MorphingPopupBorder Style="{StaticResource PopupSurfaceStyle}" Padding="5">
                                <ItemsPresenter MinWidth="210" KeyboardNavigation.DirectionalNavigation="Cycle"
                                                KeyboardNavigation.TabNavigation="Cycle" />
                            </helpers:MorphingPopupBorder>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ItemIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
