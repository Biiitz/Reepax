<Window x:Class="Reepax.Views.ExtensionOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Reepax.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Settings"
        Icon="pack://application:,,,/Reepax;component/Assets/app.ico"
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="ExtensionIconImage" Width="16" Height="16" Margin="2,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" />
                <Path x:Name="DefaultIconPath" Data="{StaticResource IconSettings}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="2,0,8,0" />
                <TextBlock x:Name="ExtensionNameText" Text="{loc:Loc ExtensionOptions_DefaultExtensionName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <wv2:WebView2 Grid.Row="1" x:Name="WebView" />
    </Grid>
</Window>
