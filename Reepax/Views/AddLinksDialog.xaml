<Window x:Class="Reepax.Views.AddLinksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Reepax.Converters"
        Title="{loc:Loc AddLinks_Title}"
        Icon="pack://application:,,,/Reepax;component/Assets/app.ico"
        Height="480" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Large Links Input -->
            <RowDefinition Height="*" MinHeight="130" />
            <!-- 1: Download Target Directory -->
            <RowDefinition Height="Auto" />
            <!-- 2: Package Name -->
            <RowDefinition Height="Auto" />
            <!-- 3: Options (Auto-extraction / Low-resource mode) -->
            <RowDefinition Height="Auto" />
            <!-- 4: Future Update Hint -->
            <RowDefinition Height="Auto" />
            <!-- 5: Summary & Bottom Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Links Input Area with Watermark -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,0,10">
            <Grid>
                <TextBox x:Name="LinksTextBox" 
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="10,8"
                         Background="{DynamicResource BgInputBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0"
                         TextChanged="LinksTextBox_TextChanged" />
                <TextBlock x:Name="LinksWatermark" 
                           Text="{loc:Loc AddLinks_Watermark_Links}" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           Opacity="0.55" 
                           FontSize="12" 
                           Margin="12,10,0,0" 
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- 1: Download Target Directory Row with Browse Button -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextSecondaryBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="2,0,10,0" />
                <TextBox Grid.Column="1" x:Name="DownloadPathTextBox" FontSize="11.5" Padding="6,4" VerticalAlignment="Center"
                         Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                         TextChanged="DownloadPathTextBox_TextChanged" />
                <Button x:Name="BrowseFolderButton" Grid.Column="2" Content="{loc:Loc Common_Browse}" Click="BrowseFolder_Click" Style="{DynamicResource ModernButtonStyle}" Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 2: Package Name Row -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconFile}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="3,0,10,0" />
                <Grid Grid.Column="1">
                    <TextBox x:Name="PackageNameTextBox" FontSize="12" FontWeight="SemiBold" Padding="6,4" VerticalAlignment="Center"
                             Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                             TextChanged="PackageNameTextBox_TextChanged" />
                    <TextBlock x:Name="PackageNameWatermark" 
                               Text="{loc:Loc AddLinks_Watermark_PackageName}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               Opacity="0.55" 
                               FontSize="11.5" 
                               Margin="8,5,0,0" 
                               IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <!-- 3: Options Row (Auto-extraction & low-resource mode) -->
        <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconSettings}" Fill="{DynamicResource TextSecondaryBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="3,0,12,0" />
                
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 1. Automatic Extraction Checkbox with Delayed Tooltip (Default: Off) -->
                    <CheckBox x:Name="AutoExtractCheckBox" IsChecked="False" Content="{loc:Loc AddLinks_Option_AutoExtract}" 
                              FontSize="11.5" VerticalAlignment="Center" Margin="0,2,14,2"
                              ToolTip="{loc:Loc AddLinks_Option_AutoExtract_ToolTip}"
                              Checked="AutoExtractCheckBox_CheckedChanged" Unchecked="AutoExtractCheckBox_CheckedChanged" />

                    <!-- 2. Low-Resource Extraction Checkbox with Delayed Tooltip (Default: Off) -->
                    <StackPanel x:Name="LowResourceContainer" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2" IsEnabled="False">
                        <CheckBox x:Name="LowResourceCheckBox" IsChecked="False" Content="{loc:Loc AddLinks_Option_LowResource}" 
                                  FontSize="11.5" VerticalAlignment="Center"
                                  ToolTip="{loc:Loc AddLinks_Option_LowResource_ToolTip}" />

                        <!-- Simple 'Recommended' text in bright blue -->
                        <TextBlock x:Name="RecommendedText" Text="{loc:Loc Common_Recommended_Parentheses}" 
                                   FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#3B82F6" 
                                   VerticalAlignment="Center" Margin="5,0,0,0" 
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <!-- 3. Delete archive files after extraction Checkbox with Delayed Tooltip (Default: Off) -->
                    <CheckBox x:Name="DeleteArchivesCheckBox" IsChecked="False" Content="{loc:Loc AddLinks_Option_DeleteArchives}" 
                              FontSize="11.5" VerticalAlignment="Center" Margin="0,2,14,2" IsEnabled="False"
                              ToolTip="{loc:Loc AddLinks_Option_DeleteArchives_ToolTip}" 
                              Checked="DeleteArchivesCheckBox_Checked" />

                    <!-- 4. Move archive files to recycle bin Checkbox with Delayed Tooltip (Default: Off) -->
                    <CheckBox x:Name="RecycleArchivesCheckBox" IsChecked="False" Content="{loc:Loc AddLinks_Option_RecycleArchives}" 
                              FontSize="11.5" VerticalAlignment="Center" Margin="0,2,0,2" IsEnabled="False"
                              ToolTip="{loc:Loc AddLinks_Option_RecycleArchives_ToolTip}" 
                              Checked="RecycleArchivesCheckBox_Checked" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 4: Future Update Hint -->
        <Border Grid.Row="4" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconInfo}" Fill="{DynamicResource AccentBlueBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="3,0,10,0" />
                <TextBlock Grid.Column="1" Text="{loc:Loc AddLinks_UpdateHint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 5: Summary & Action Buttons -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status Summary Text -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ExtractionSummaryText" Text="{loc:Loc AddLinks_Summary_ZeroLinks}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentBlueBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{loc:Loc AddLinks_Button_PasteClipboard}" Click="PasteClipboard_Click" Style="{DynamicResource ModernButtonStyle}" Padding="10,6" Margin="0,0,8,0" />
                <Button x:Name="AddButton" Content="{loc:Loc AddLinks_Button_AddPackage}" Click="AddLinks_Click" Style="{DynamicResource AccentButtonStyle}" Width="140" Padding="0,6" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
