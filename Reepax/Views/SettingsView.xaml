                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox Grid.Column="2"
                                    HorizontalAlignment="Right" Margin="16,0,0,0"
                                    IsChecked="{Binding EnableErrorSound, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />

                                <Border x:Name="ErrorSoundVolumeContainer" Grid.Column="1"
                                    ClipToBounds="True"
                                    Focusable="False">
                                    <Grid Margin="0" x:Name="ErrorSoundVolumeContent" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="ErrorSoundVolumeTranslate" Y="0" />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Sound Selector Dropdown & Popup -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <helpers:SingleChoiceDropdown x:Name="ErrorSoundButton" SelectedValue="{Binding SelectedErrorSound, Mode=TwoWay}" IsEnabled="{Binding EnableErrorSound}" SelectionCommitted="ErrorSound_SelectionCommitted" ItemsSource="{Binding SoundOptions}" SelectedValuePath="Value" DisplayMemberPath="Text" MaxVisibleItems="7" />
                                        </StackPanel>

                                        <!-- Right: Volume Control with Speaker Icon, Slider & Percentage Badge -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Speaker Icon -->
                                            <Path Data="{StaticResource IconVolume}"
                                                Width="14"
                                                Height="14"
                                                Stretch="Uniform"
                                                Fill="{DynamicResource TextSecondaryBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0" />

                                            <!-- Sleek Fluent Slider -->
                                            <Slider Style="{StaticResource ModernVolumeSliderStyle}"
                                                Width="130"
                                                Minimum="0"
                                                Maximum="100"
                                                SmallChange="5"
                                                LargeChange="10"
                                                Value="{Binding ErrorSoundVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PreviewMouseUp="ErrorSoundVolumeSlider_PreviewMouseUp"
                                                MouseWheel="ErrorSoundVolumeSlider_MouseWheel"
                                                VerticalAlignment="Center"
                                                Cursor="Hand" />

                                            <!-- Percentage Value Badge -->
                                            <Border Background="{DynamicResource BgInputBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource CompactCornerRadius}"
                                                Width="46"
                                                Height="24"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ErrorSoundVolume, StringFormat='{}{0}%'}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="{loc:Loc Settings_Section_Workflow}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_AutoCollapse_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_AutoCollapse_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding AutoCollapseCompletedPackages, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />

                            <!-- Clipboard Monitor -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_ClipboardMonitor_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_ClipboardMonitor_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding EnableClipboardMonitor, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />

                            <!-- Logs in AppData -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_EnableLogging_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_EnableLogging_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding EnableFileLogging, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ******************** CATEGORY 2: DOWNLOADS & CONNECTIONS ******************** -->
