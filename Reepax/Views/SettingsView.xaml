<UserControl x:Class="Reepax.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Reepax.ViewModels"
             xmlns:loc="clr-namespace:Reepax.Converters"
             xmlns:helpers="clr-namespace:Reepax.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Background="{DynamicResource BgDarkBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <loc:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />

        <!-- Setting Explanation Info ("i") Icon Styles -->
        <Style x:Key="SettingInfoIconStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="80" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="80" />
            <Setter Property="ToolTipService.ShowDuration" Value="45000" />
        </Style>

        <Style x:Key="SettingInfoPathStyle" TargetType="{x:Type Path}">
            <Setter Property="Data" Value="{StaticResource IconInfo}" />
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                    <Setter Property="Opacity" Value="1.0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Category Sidebar Item Base Style -->
        <Style x:Key="SettingsCategoryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgInputBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button in Settings -->
        <Style x:Key="SettingsActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BgCardAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgInputBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgCardBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Archive Passwords Saved Count Toggle Button Style -->
        <Style x:Key="ArchivePasswordToggleButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BgCardAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ArchivePasswordsCount}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBlueBrush}"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Settings_ArchivePasswords_Badge_Label}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Path x:Name="ChevronIcon"
                                      Data="{StaticResource IconChevronDown}"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Width="9" Height="9"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="6,0,0,0"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgInputBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                <Setter TargetName="ChevronIcon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgCardBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsArchivePasswordsExpanded}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="180" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Sound Selector Dropdown Button Style -->
        <Style x:Key="SoundDropdownButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCardBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sound Dropdown Menu Item Style -->
        <Style x:Key="SoundDropdownItemStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BgInputBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Password Action Button Style (e.g. Copy) -->
        <Style x:Key="PasswordActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgInputBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Password Delete Button Style (Danger hover) -->
        <Style x:Key="PasswordDeleteButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2AEF4444" />
                                <Setter Property="Foreground" Value="#EF4444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44EF4444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Volume Slider Style matching Reepax Theme -->
        <Style x:Key="ModernVolumeSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track Line -->
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="{DynamicResource BgInputBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True" />
                            <!-- Active Track with Accent Fill -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Style>
                                            <Style TargetType="{x:Type RepeatButton}">
                                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                                <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="IsTabStop" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Style>
                                            <Style TargetType="{x:Type Thumb}">
                                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Grid Width="16" Height="16">
                                                                <Ellipse x:Name="OuterGlow" Width="16" Height="16" Fill="{DynamicResource AccentBlueBrush}" Opacity="0">
                                                                    <Ellipse.Effect>
                                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#38BDF8" Opacity="0.6" />
                                                                    </Ellipse.Effect>
                                                                </Ellipse>
                                                                <Ellipse x:Name="ThumbBody" Width="12" Height="12" Fill="{DynamicResource AccentBlueBrush}" Stroke="#FFFFFF" StrokeThickness="1.5" SnapsToDevicePixels="True" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="OuterGlow" Property="Opacity" Value="0.6" />
                                                                    <Setter TargetName="ThumbBody" Property="Fill" Value="#FFFFFF" />
                                                                    <Setter TargetName="ThumbBody" Property="Stroke" Value="{DynamicResource AccentBlueBrush}" />
                                                                    <Setter TargetName="ThumbBody" Property="Width" Value="13" />
                                                                    <Setter TargetName="ThumbBody" Property="Height" Value="13" />
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="OuterGlow" Property="Opacity" Value="0.9" />
                                                                    <Setter TargetName="ThumbBody" Property="Fill" Value="#FFFFFF" />
                                                                    <Setter TargetName="ThumbBody" Property="Stroke" Value="{DynamicResource AccentBlueBrush}" />
                                                                    <Setter TargetName="ThumbBody" Property="Width" Value="14" />
                                                                    <Setter TargetName="ThumbBody" Property="Height" Value="14" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Style>
                                            <Style TargetType="{x:Type RepeatButton}">
                                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="IsTabStop" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                            <Rectangle Fill="Transparent" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Category Sidebar -->
            <ColumnDefinition Width="236" />
            <!-- Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT CATEGORY SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgHeaderBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="0,0,1,0">
            <!-- Category List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12">
                <Grid x:Name="CategoryButtonsContainer">
                    <StackPanel x:Name="CategoryButtonsPanel">
                        <!-- 1. General -->
                        <Button x:Name="GeneralCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="General">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="General">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconSliders}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="General">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_General}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- 2. Downloads & Connections -->
                        <Button x:Name="DownloadsCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="DownloadConnections">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="DownloadConnections">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconDownload}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="DownloadConnections">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_Downloads}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- 3. Keyboard Shortcuts -->
                        <Button x:Name="ShortcutsCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="Shortcuts">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Shortcuts">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconKeyboard}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Shortcuts">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_Shortcuts}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- 4. About -->
                        <Button x:Name="AboutCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="About">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="About">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconInfo}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="About">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_About}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Animated Sliding Blue Pill Indicator -->
                    <Border x:Name="SlidingCategoryIndicator"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="3"
                            Height="18"
                            CornerRadius="1.5"
                            Background="{DynamicResource AccentBlueBrush}"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CategoryIndicatorTransform" X="18" Y="10" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Direction="0" ShadowDepth="0" BlurRadius="6" Color="#38BDF8" Opacity="0.25" />
                        </Border.Effect>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ==================== RIGHT CONTENT PANE ==================== -->
        <ScrollViewer x:Name="SettingsContentScrollViewer"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      Background="{DynamicResource BgDarkBrush}"
                      PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
            <Grid Margin="32,28,40,32" HorizontalAlignment="Stretch">

                <!-- ******************** CATEGORY 1: GENERAL ******************** -->
                <StackPanel x:Name="CategoryGeneral"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='General|Notifications'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>
                    <!-- Language -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Language_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Language_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="{loc:Loc Settings_Language_English}"
                                         IsChecked="{Binding IsEnglishSelected, Mode=TwoWay}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Margin="0,0,14,0"
                                         Cursor="Hand" />
                            <RadioButton Content="{loc:Loc Settings_Language_German}"
                                         IsChecked="{Binding IsGermanSelected, Mode=TwoWay}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Cursor="Hand" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Nach Abschluss aller Downloads (Post-Download Action) - direkt unter Sprache -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_PostDownload_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_PostDownload_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="{loc:Loc PostDownload_Action_None}"
                                         IsChecked="{Binding IsNoneActionSelected, Mode=TwoWay}"
                                         GroupName="PostDownloadActionGroup"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Margin="0,0,12,0"
                                         Cursor="Hand" />
                            <RadioButton Content="{loc:Loc PostDownload_Action_Shutdown}"
                                         IsChecked="{Binding IsShutdownActionSelected, Mode=TwoWay}"
                                         GroupName="PostDownloadActionGroup"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Margin="0,0,12,0"
                                         Cursor="Hand" />
                            <RadioButton Content="{loc:Loc PostDownload_Action_Sleep}"
                                         IsChecked="{Binding IsSleepActionSelected, Mode=TwoWay}"
                                         GroupName="PostDownloadActionGroup"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Margin="0,0,12,0"
                                         Cursor="Hand" />
                            <RadioButton Content="{loc:Loc PostDownload_Action_ExitApp}"
                                         IsChecked="{Binding IsExitAppActionSelected, Mode=TwoWay}"
                                         GroupName="PostDownloadActionGroup"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Cursor="Hand" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,8" Opacity="{Binding IsStartWithWindowsEnabled, Converter={StaticResource BoolToOpacityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Settings_StartWithWindows_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_StartWithWindows_Subtitle}">
                                    <Path Style="{StaticResource SettingInfoPathStyle}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Settings_StartWithWindows_PortableDisabled}" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" FontStyle="Italic" Margin="0,2,0,0" Visibility="{Binding IsPortableMode, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsEnabled="{Binding IsStartWithWindowsEnabled}"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- In Infobereich minimieren beim Schließen -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_MinimizeToTrayOnClose_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_MinimizeToTrayOnClose_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Benachrichtigungen aktivieren -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Notifications_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Notifications_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding EnableCompletionNotifications, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- ==================== 1. ABSCHLUSS-SOUND ==================== -->
                    <StackPanel Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_Sound_Completion_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Sound_Completion_Subtitle}">
                                    <Path Style="{StaticResource SettingInfoPathStyle}" />
                                </Border>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      IsChecked="{Binding EnableCompletionSound, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Cursor="Hand" />
                        </Grid>

                        <!-- Animated Completion Sound Sub-Row (Dropdown Left, Volume Right, and Trigger Selector) -->
                        <Border x:Name="CompletionSoundVolumeContainer"
                                ClipToBounds="True"
                                Focusable="False">
                            <StackPanel Margin="0,10,0,2" x:Name="CompletionSoundVolumeContent" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="CompletionSoundVolumeTranslate" Y="0" />
                                </StackPanel.RenderTransform>

                                <!-- Top Sub-Row: Sound Selector & Volume Slider -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Sound Selector Dropdown & Popup -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="CompletionSoundButton"
                                                Style="{StaticResource SoundDropdownButtonStyle}"
                                                IsEnabled="{Binding EnableCompletionSound}"
                                                PreviewMouseDown="CompletionSoundButton_PreviewMouseDown"
                                                Click="CompletionSoundButton_Click"
                                                PreviewKeyDown="CompletionSound_PreviewKeyDown"
                                                PreviewMouseWheel="CompletionSound_PreviewMouseWheel"
                                                VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedCompletionSoundDisplayName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />
                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 3.5,3.5 L 7,0"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      Width="7"
                                                      Height="4"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!-- Popup for Completion Sound Selection -->
                                        <Popup x:Name="CompletionSoundPopup"
                                               PlacementTarget="{Binding ElementName=CompletionSoundButton}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               VerticalOffset="4"
                                               Closed="CompletionSoundPopup_Closed"
                                               PreviewKeyDown="CompletionSound_PreviewKeyDown"
                                               PreviewMouseWheel="CompletionSound_PreviewMouseWheel">
                                            <Border Background="{DynamicResource BgCardBrush}"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="4"
                                                    Width="136"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True">
                                                <Border.Effect>
                                                    <DropShadowEffect Direction="270" ShadowDepth="4" BlurRadius="12" Color="#000000" Opacity="0.45" />
                                                </Border.Effect>
                                                <StackPanel>
                                                    <!-- Sound 1 -->
                                                    <Button Style="{StaticResource SoundDropdownItemStyle}"
                                                            Click="CompletionSoundOption_Click"
                                                            Command="{Binding SelectAndPreviewCompletionSoundCommand}"
                                                            CommandParameter="1.mp3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Sound 1" FontSize="11.5" VerticalAlignment="Center" />
                                                            <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                  Visibility="{Binding SelectedCompletionSound, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='1.mp3'}" />
                                                        </Grid>
                                                    </Button>
                                                    <!-- Sound 2 -->
                                                    <Button Style="{StaticResource SoundDropdownItemStyle}"
                                                            Click="CompletionSoundOption_Click"
                                                            Command="{Binding SelectAndPreviewCompletionSoundCommand}"
                                                            CommandParameter="2.mp3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Sound 2" FontSize="11.5" VerticalAlignment="Center" />
                                                            <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                  Visibility="{Binding SelectedCompletionSound, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='2.mp3'}" />
                                                        </Grid>
                                                    </Button>
                                                    <!-- Sound 3 -->
                                                    <Button Style="{StaticResource SoundDropdownItemStyle}"
                                                            Click="CompletionSoundOption_Click"
                                                            Command="{Binding SelectAndPreviewCompletionSoundCommand}"
                                                            CommandParameter="3.mp3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Sound 3" FontSize="11.5" VerticalAlignment="Center" />
                                                            <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                  Visibility="{Binding SelectedCompletionSound, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='3.mp3'}" />
                                                        </Grid>
                                                    </Button>
                                                    <!-- Sound 4 -->
                                                    <Button Style="{StaticResource SoundDropdownItemStyle}"
                                                            Click="CompletionSoundOption_Click"
                                                            Command="{Binding SelectAndPreviewCompletionSoundCommand}"
                                                            CommandParameter="4.mp3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Sound 4" FontSize="11.5" VerticalAlignment="Center" />
                                                            <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                  Visibility="{Binding SelectedCompletionSound, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='4.mp3'}" />
                                                        </Grid>
                                                    </Button>
                                                    <!-- Sound 5 -->
                                                    <Button Style="{StaticResource SoundDropdownItemStyle}"
                                                            Click="CompletionSoundOption_Click"
                                                            Command="{Binding SelectAndPreviewCompletionSoundCommand}"
                                                            CommandParameter="5.mp3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Sound 5" FontSize="11.5" VerticalAlignment="Center" />
                                                            <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                  Visibility="{Binding SelectedCompletionSound, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='5.mp3'}" />
                                                        </Grid>
                                                    </Button>
                                                    <!-- Sound 6 -->
                                                    <Button Style="{StaticResource SoundDropdownItemStyle}"
                                                            Click="CompletionSoundOption_Click"
                                                            Command="{Binding SelectAndPreviewCompletionSoundCommand}"
                                                            CommandParameter="6.mp3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Sound 6" FontSize="11.5" VerticalAlignment="Center" />
                                                            <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                  Visibility="{Binding SelectedCompletionSound, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='6.mp3'}" />
                                                        </Grid>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <!-- Right: Volume Control with Speaker Icon, Slider & Percentage Badge -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Speaker Icon -->
                                        <Path Data="{StaticResource IconVolume}"
                                              Width="14"
                                              Height="14"
                                              Stretch="Uniform"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0" />

                                        <!-- Sleek Fluent Slider -->
                                        <Slider Style="{StaticResource ModernVolumeSliderStyle}"
                                                Width="130"
                                                Minimum="0"
                                                Maximum="100"
                                                SmallChange="5"
                                                LargeChange="10"
                                                Value="{Binding CompletionSoundVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PreviewMouseUp="CompletionSoundVolumeSlider_PreviewMouseUp"
                                                MouseWheel="CompletionSoundVolumeSlider_MouseWheel"
                                                VerticalAlignment="Center"
                                                Cursor="Hand" />

                                        <!-- Percentage Value Badge -->
                                        <Border Background="{DynamicResource BgInputBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Width="46"
                                                Height="24"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CompletionSoundVolume, StringFormat='{}{0}%'}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Sub-Row: Trigger Selector (Entire Package vs Individual Files) -->
                                <Grid Margin="0,14,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Settings_Sound_Trigger_Title}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Sound_Trigger_Subtitle}">
                                            <Path Style="{StaticResource SettingInfoPathStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton GroupName="CompletionSoundTriggerGroup"
                                                     Content="{loc:Loc Settings_Sound_Trigger_EntirePackage}"
                                                     IsChecked="{Binding IsCompletionSoundEntirePackage, Mode=TwoWay}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     FontWeight="SemiBold"
                                                     FontSize="11.5"
                                                     Margin="0,0,14,0"
                                                     Cursor="Hand" />
                                        <RadioButton GroupName="CompletionSoundTriggerGroup"
                                                     Content="{loc:Loc Settings_Sound_Trigger_IndividualFiles}"
                                                     IsChecked="{Binding IsCompletionSoundIndividualFiles, Mode=TwoWay}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     FontWeight="SemiBold"
                                                     FontSize="11.5"
                                                     Cursor="Hand" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- ==================== 2. FEHLGESCHLAGEN-SOUND ==================== -->
                    <StackPanel Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Loc Settings_Sound_Error_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Sound_Error_Subtitle}">
                                    <Path Style="{StaticResource SettingInfoPathStyle}" />
                                </Border>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      IsChecked="{Binding EnableErrorSound, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Cursor="Hand" />
                        </Grid>

                        <!-- Animated Error Sound Sub-Row (Dropdown Left, Volume Right) -->
                        <Border x:Name="ErrorSoundVolumeContainer"
                                ClipToBounds="True"
                                Focusable="False">
                            <Grid Margin="0,10,0,2" x:Name="ErrorSoundVolumeContent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="ErrorSoundVolumeTranslate" Y="0" />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Sound Selector Dropdown & Popup -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ErrorSoundButton"
                                            Style="{StaticResource SoundDropdownButtonStyle}"
                                            IsEnabled="{Binding EnableErrorSound}"
                                            PreviewMouseDown="ErrorSoundButton_PreviewMouseDown"
                                            Click="ErrorSoundButton_Click"
                                            PreviewKeyDown="ErrorSound_PreviewKeyDown"
                                            PreviewMouseWheel="ErrorSound_PreviewMouseWheel"
                                            VerticalAlignment="Center">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SelectedErrorSoundDisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />
                                            <Path Grid.Column="1"
                                                  Data="M 0,0 L 3.5,3.5 L 7,0"
                                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5"
                                                  Width="7"
                                                  Height="4"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <!-- Popup for Error Sound Selection -->
                                    <Popup x:Name="ErrorSoundPopup"
                                           PlacementTarget="{Binding ElementName=ErrorSoundButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade"
                                           VerticalOffset="4"
                                           Closed="ErrorSoundPopup_Closed"
                                           PreviewKeyDown="ErrorSound_PreviewKeyDown"
                                           PreviewMouseWheel="ErrorSound_PreviewMouseWheel">
                                        <Border Background="{DynamicResource BgCardBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="4"
                                                Width="136"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True">
                                            <Border.Effect>
                                                <DropShadowEffect Direction="270" ShadowDepth="4" BlurRadius="12" Color="#000000" Opacity="0.45" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <!-- Sound 1 -->
                                                <Button Style="{StaticResource SoundDropdownItemStyle}"
                                                        Click="ErrorSoundOption_Click"
                                                        Command="{Binding SelectAndPreviewErrorSoundCommand}"
                                                        CommandParameter="1.mp3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Sound 1" FontSize="11.5" VerticalAlignment="Center" />
                                                        <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                                              Visibility="{Binding SelectedErrorSound, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='1.mp3'}" />
                                                    </Grid>
                                                </Button>
                                                <!-- Sound 2 -->
                                                <Button Style="{StaticResource SoundDropdownItemStyle}"
                                                        Click="ErrorSoundOption_Click"
                                                        Command="{Binding SelectAndPreviewErrorSoundCommand}"
                                                        CommandParameter="2.mp3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Sound 2" FontSize="11.5" VerticalAlignment="Center" />
                                                        <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                                              Visibility="{Binding SelectedErrorSound, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='2.mp3'}" />
                                                    </Grid>
                                                </Button>
                                                <!-- Sound 3 -->
                                                <Button Style="{StaticResource SoundDropdownItemStyle}"
                                                        Click="ErrorSoundOption_Click"
                                                        Command="{Binding SelectAndPreviewErrorSoundCommand}"
                                                        CommandParameter="3.mp3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Sound 3" FontSize="11.5" VerticalAlignment="Center" />
                                                        <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                                              Visibility="{Binding SelectedErrorSound, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='3.mp3'}" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <!-- Right: Volume Control with Speaker Icon, Slider & Percentage Badge -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Speaker Icon -->
                                    <Path Data="{StaticResource IconVolume}"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />

                                    <!-- Sleek Fluent Slider -->
                                    <Slider Style="{StaticResource ModernVolumeSliderStyle}"
                                            Width="130"
                                            Minimum="0"
                                            Maximum="100"
                                            SmallChange="5"
                                            LargeChange="10"
                                            Value="{Binding ErrorSoundVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PreviewMouseUp="ErrorSoundVolumeSlider_PreviewMouseUp"
                                            MouseWheel="ErrorSoundVolumeSlider_MouseWheel"
                                            VerticalAlignment="Center"
                                            Cursor="Hand" />

                                    <!-- Percentage Value Badge -->
                                    <Border Background="{DynamicResource BgInputBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Width="46"
                                            Height="24"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ErrorSoundVolume, StringFormat='{}{0}%'}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Automatically collapse completed packages -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_AutoCollapse_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_AutoCollapse_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding AutoCollapseCompletedPackages, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Zwischenablage-Überwachung (Clipboard Monitor) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_ClipboardMonitor_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_ClipboardMonitor_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding EnableClipboardMonitor, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Dateiprotokolle (Logs in AppData) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_EnableLogging_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_EnableLogging_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding EnableFileLogging, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>
                </StackPanel>

                <!-- ******************** CATEGORY 2: DOWNLOADS & CONNECTIONS ******************** -->
                <StackPanel x:Name="CategoryDownloadConnections"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='DownloadConnections'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>

                    <!-- Speed limit (MB/s) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_SpeedLimit_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_SpeedLimit_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" ClipToBounds="True">
                                    <TextBlock x:Name="SpeedLimitGhostText"
                                               Text=""
                                               Opacity="0"
                                               Background="Transparent"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Padding="6,2"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="SpeedLimitGhostTranslate" Y="0" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBox x:Name="SpeedLimitBox"
                                             Text="{Binding SpeedLimitText, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="NumericSpinner"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             Padding="6,2"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             HorizontalContentAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             PreviewMouseWheel="SpeedLimit_PreviewMouseWheel"
                                             TextChanged="SpeedLimitBox_TextChanged">
                                        <TextBox.RenderTransform>
                                            <TranslateTransform x:Name="SpeedLimitTranslate" Y="0" />
                                        </TextBox.RenderTransform>
                                    </TextBox>
                                </Grid>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                             <RowDefinition Height="*" />
                                             <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Command="{Binding IncrementSpeedLimitCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Row="1" Command="{Binding DecrementSpeedLimitCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource BgCardAltBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="MB/s" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- Maximum concurrent downloads -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_ConcurrentDownloads_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_ConcurrentDownloads_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" ClipToBounds="True">
                                    <TextBlock x:Name="MaxDownloadsGhostText"
                                               Text=""
                                               Opacity="0"
                                               Background="Transparent"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Padding="4,2"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="MaxDownloadsGhostTranslate" Y="0" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBox x:Name="MaxDownloadsBox"
                                             Text="{Binding MaxConcurrentDownloadsText, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="NumericSpinner"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             Padding="4,2"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             PreviewMouseWheel="MaxDownloads_PreviewMouseWheel"
                                             TextChanged="MaxDownloadsBox_TextChanged">
                                        <TextBox.RenderTransform>
                                            <TranslateTransform x:Name="MaxDownloadsTranslate" Y="0" />
                                        </TextBox.RenderTransform>
                                    </TextBox>
                                </Grid>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Command="{Binding IncrementMaxDownloadsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Row="1" Command="{Binding DecrementMaxDownloadsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- Connections per download (chunks) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Connections_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Connections_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" ClipToBounds="True">
                                    <TextBlock x:Name="ConnectionsGhostText"
                                               Text=""
                                               Opacity="0"
                                               Background="Transparent"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Padding="4,2"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="ConnectionsGhostTranslate" Y="0" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBox x:Name="ConnectionsBox"
                                             Text="{Binding ConnectionsPerDownloadText, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="NumericSpinner"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             Padding="4,2"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             PreviewMouseWheel="Connections_PreviewMouseWheel"
                                             TextChanged="ConnectionsBox_TextChanged">
                                        <TextBox.RenderTransform>
                                            <TranslateTransform x:Name="ConnectionsTranslate" Y="0" />
                                        </TextBox.RenderTransform>
                                    </TextBox>
                                </Grid>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Command="{Binding IncrementConnectionsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Row="1" Command="{Binding DecrementConnectionsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- ==================== SPIEL-INSTALLATIONSORDNER ==================== -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_GameInstall_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_GameInstall_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding CreateGameInstallFolder, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <!-- Path selection -->
                    <Border x:Name="GameInstallPathContainer"
                            ClipToBounds="True"
                            Focusable="False">
                        <Grid Margin="0,4,0,0" x:Name="GameInstallPathContent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="GameInstallPathTranslate" Y="0" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{loc:Loc Settings_GameInstall_PathSubtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,8,0">
                                    <TextBox Text="{Binding GameInstallDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             Padding="10,0"
                                             FontSize="12"
                                             VerticalContentAlignment="Center" />
                                </Border>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Command="{Binding BrowseGameInstallDirectoryCommand}"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource AccentBlueBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc Common_Browse}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Command="{Binding OpenGameInstallDirectoryCommand}"
                                        ToolTip="{Binding GameInstallDirectory}"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- 1. Automatisches Entpacken (Standard) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_AutoExtract_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_AutoExtract_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding AutoExtractArchives, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- 2. PC-schonender Entpackungsmodus (Standard) -->
                    <Grid Margin="0,0,0,8"
                          Opacity="{Binding AutoExtractArchives, Converter={StaticResource BoolToOpacityConverter}}"
                          IsEnabled="{Binding AutoExtractArchives}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_LowResource_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_LowResource_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                            <TextBlock Text="{loc:Loc Common_Recommended_Parentheses}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding IsLowResourceRecommended, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding LowResourceExtraction, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- 3. Archive nach dem Entpacken löschen (Standard) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_DeleteArchives_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_DeleteArchives_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding DeleteArchiveAfterExtraction, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- 4. In den Papierkorb verschieben (Standard) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_RecycleArchives_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_RecycleArchives_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding MoveArchiveToRecycleBin, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- ==================== PAR2 AUTO-REPAIR ==================== -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_AutoPar2Repair_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_AutoPar2Repair_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding AutoPar2Repair, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- PAR2 Cleanup -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_DeletePar2AfterExtraction_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_DeletePar2AfterExtraction_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding DeletePar2AfterExtraction, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- ==================== SAVED ARCHIVE PASSWORDS ==================== -->
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Settings_Card_ArchivePasswords_Title}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Card_ArchivePasswords_Subtitle}">
                                <Path Style="{StaticResource SettingInfoPathStyle}" />
                            </Border>
                        </StackPanel>

                        <!-- Password Input and Action Buttons Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Input Box -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BgInputBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="30"
                                    Margin="0,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0"
                                          Data="{StaticResource IconKey}"
                                          Fill="{DynamicResource TextMutedBrush}"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="10,0,4,0" />

                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="NewArchivePasswordTextBox"
                                                 Text="{Binding NewArchivePasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="NewArchivePasswordTextBox_KeyDown"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="12"
                                                 Padding="4,0,8,0"
                                                 VerticalContentAlignment="Center">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddArchivePasswordCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>

                                        <TextBlock Text="{loc:Loc Settings_ArchivePasswords_Placeholder}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding HasNewArchivePasswordInput, Converter={StaticResource InverseBoolToVisConverter}}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Add Button -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Command="{Binding AddArchivePasswordCommand}"
                                    IsEnabled="{Binding HasNewArchivePasswordInput}"
                                    Height="30"
                                    Margin="0,0,6,0"
                                    ToolTip="{loc:Loc Settings_ArchivePasswords_Add}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconPlus}"
                                          Fill="{DynamicResource AccentBlueBrush}"
                                          Width="10" Height="10"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Settings_ArchivePasswords_Add}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Saved Count Toggle Button -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource ArchivePasswordToggleButtonStyle}"
                                    Command="{Binding ToggleArchivePasswordsExpandedCommand}"
                                    ToolTip="{loc:Loc Settings_ArchivePasswords_Toggle_ToolTip}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Expandable Passwords List -->
                        <helpers:AnimatedExpansionDecorator IsExpanded="{Binding IsArchivePasswordsExpanded}">
                            <Border Background="{DynamicResource BgInputBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    Margin="0,8,0,0">
                                <Grid>
                                    <!-- Empty State -->
                                    <StackPanel Visibility="{Binding HasArchivePasswords, Converter={StaticResource InverseBoolToVisConverter}}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,20">
                                        <Path Data="{StaticResource IconKey}"
                                              Fill="{DynamicResource TextMutedBrush}"
                                              Width="22" Height="22"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,8"
                                              Opacity="0.45" />
                                        <TextBlock Text="{loc:Loc Settings_ArchivePasswords_Empty}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Settings_ArchivePasswords_Empty_Detail}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="16,4,16,0"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Opacity="0.75" />
                                    </StackPanel>

                                    <!-- Passwords List -->
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False"
                                                  Visibility="{Binding HasArchivePasswords, Converter={StaticResource BoolToVisConverter}}">
                                        <ItemsControl ItemsSource="{Binding ArchivePasswords}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="12,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Subtle key icon bullet -->
                                                            <Path Grid.Column="0"
                                                                  Data="{StaticResource IconKey}"
                                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                                  Width="11" Height="11"
                                                                  Stretch="Uniform"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,10,0"
                                                                  Opacity="0.65" />

                                                            <!-- Password Text in clean monospace style -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding}"
                                                                       FontFamily="Consolas, Cascadia Code, Segoe UI Mono, monospace"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding}" />

                                                            <!-- Action Buttons: Copy & Remove -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Copy Button -->
                                                                <Button Command="{Binding DataContext.CopyArchivePasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource PasswordActionButtonStyle}"
                                                                        ToolTip="{loc:Loc Settings_ArchivePasswords_Copy}"
                                                                        Width="28" Height="26"
                                                                        Margin="0,0,4,0">
                                                                    <Path Data="{StaticResource IconCopy}"
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                          Width="12" Height="12"
                                                                          Stretch="Uniform"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                                </Button>

                                                                <!-- Remove Button (red hover) -->
                                                                <Button Command="{Binding DataContext.RemoveArchivePasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource PasswordDeleteButtonStyle}"
                                                                        ToolTip="{loc:Loc Settings_ArchivePasswords_Remove}"
                                                                        Width="28" Height="26">
                                                                    <Path Data="{StaticResource IconTrash}"
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                          Width="12" Height="12"
                                                                          Stretch="Uniform"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </helpers:AnimatedExpansionDecorator>
                    </StackPanel>
                </StackPanel>

                <!-- ******************** CATEGORY 3: KEYBOARD SHORTCUTS ******************** -->
                <StackPanel x:Name="CategoryShortcuts"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Shortcuts'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>

                    <!-- Shortcuts List -->
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="16,12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Title & Description -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Shortcut Key Button & Reset Button -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Key Binding Button -->
                                            <Button Command="{Binding DataContext.StartRecordingShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Padding="12,5"
                                                    MinWidth="110">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="BtnBorder"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <!-- Normal Key Display -->
                                                    <TextBlock Text="{Binding DisplayGesture}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Recording Prompt -->
                                                    <TextBlock Text="{loc:Loc Settings_Shortcuts_RecordingPrompt}"
                                                               FontWeight="Bold"
                                                               FontSize="11.5"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Button>

                                            <!-- Reset Single Shortcut Button (Visible only when customized) -->
                                            <Button Command="{Binding DataContext.ResetShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{loc:Loc Settings_Shortcuts_ResetOne}"
                                                    Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ******************** CATEGORY 4: ABOUT ******************** -->
                <StackPanel x:Name="CategoryAbout"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='About'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>

                    <!-- Centered Header (Logo without background, Name, Version as pure blue text) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,6,0,22">
                        <Image Source="pack://application:,,,/Reepax;component/Assets/R.png" 
                               Width="68" Height="68" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,10" />

                        <TextBlock Text="Reepax" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,3" />

                        <!-- Version as pure blue text without box/border/background -->
                        <TextBlock Text="{Binding AppDisplayVersion}" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AccentBlueBrush}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Section 1: System & Laufzeitumgebung (Diagnostics) -->
                    <Border Background="{DynamicResource BgCardBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="20,16" 
                            Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_SystemDiagnostics_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" 
                                        Command="{Binding CopySystemDiagnosticInfoCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_CopyDiagnostics_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- OS -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_OS_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding OperatingSystemInfo}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Runtime -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_Runtime_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DotNetRuntimeInfo}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Architecture -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_Architecture_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ArchitectureInfo}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Native Engine -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_NativeEngine_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc About_NativeEngine_Value}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Archive & Repair Engine -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_ArchiveEngine_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc About_ArchiveEngine_Value}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Storage & Directories -->
                    <Border Background="{DynamicResource BgCardBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="20,16" 
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc About_Directories_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                            <!-- AppData Path -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_AppDataFolder_Label}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding AppDataFolderPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Command="{Binding OpenAppDataFolderInExplorerCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}" 
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_OpenFolder_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,8,0,10" />

                            <!-- Logs Path -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_LogsFolder_Label}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding LogsFolderPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Command="{Binding OpenLogsFolderInExplorerCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}" 
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_OpenFolder_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,8,0,10" />

                            <!-- Downloads Path -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_DownloadsFolder_Label}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CurrentDownloadDirectory}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Command="{Binding OpenDefaultDownloadFolderCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}" 
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_OpenFolder_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Developer & Links -->
                    <Border Background="{DynamicResource BgCardBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_Developer_Label}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{loc:Loc About_Developer_Value}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Copyright © 2026 Biiitz" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </DockPanel>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Command="{Binding OpenGitHubRepositoryCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}" 
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGitHub}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_Links_Repository}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenGitHubReleasesCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}" 
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconHistory}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_Links_Releases}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenGitHubIssuesCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExternalLink}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_Links_Issues}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
