                                <Border x:Name="CompletionSoundVolumeContainer" Grid.Column="1"
                                    ClipToBounds="True"
                                    Focusable="False">
                                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" x:Name="CompletionSoundVolumeContent" RenderTransformOrigin="0.5,0.5">
