                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="22" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" ClipToBounds="True">
                                            <TextBlock x:Name="ConnectionsGhostText"
                                                Text=""
                                                Opacity="0"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Padding="4,2"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="ConnectionsGhostTranslate" Y="0" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBox x:Name="ConnectionsBox"
                                                Text="{Binding ConnectionsPerDownloadText, UpdateSourceTrigger=PropertyChanged}"
                                                Tag="NumericSpinner"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                PreviewMouseWheel="Connections_PreviewMouseWheel"
                                                TextChanged="ConnectionsBox_TextChanged">
                                                <TextBox.RenderTransform>
                                                    <TranslateTransform x:Name="ConnectionsTranslate" Y="0" />
                                                </TextBox.RenderTransform>
                                            </TextBox>
                                        </Grid>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Button Grid.Row="0" Command="{Binding IncrementConnectionsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                    <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                                <Button Grid.Row="1" Command="{Binding DecrementConnectionsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                    <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="{loc:Loc Settings_Section_Extraction}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc Settings_AutoExtract_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_AutoExtract_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding AutoExtractArchives, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />

                            <!-- 2. Low-impact extraction mode (Default) -->
                            <Grid Margin="0,0,0,8"
                                Opacity="{Binding AutoExtractArchives, Converter={StaticResource BoolToOpacityConverter}}"
                                IsEnabled="{Binding AutoExtractArchives}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc Settings_LowResource_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_LowResource_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                    <TextBlock Text="{loc:Loc Common_Recommended_Parentheses}"
                                        FontSize="11" FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentBlueBrush}"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        Visibility="{Binding IsLowResourceRecommended, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding LowResourceExtraction, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />

                            <!-- 3. Delete archives after extraction (Default) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc Settings_DeleteArchives_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_DeleteArchives_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding DeleteArchiveAfterExtraction, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />

                            <!-- 4. Move to Recycle Bin (Default) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc Settings_RecycleArchives_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_RecycleArchives_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding MoveArchiveToRecycleBin, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />

                            <!-- ==================== PAR2 AUTO-REPAIR ==================== -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc Settings_AutoPar2Repair_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_AutoPar2Repair_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding AutoPar2Repair, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />

                            <!-- PAR2 Cleanup -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc Settings_DeletePar2AfterExtraction_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_DeletePar2AfterExtraction_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding DeletePar2AfterExtraction, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="{loc:Loc Settings_Card_ArchivePasswords_Title}"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Card_ArchivePasswords_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>

                                <!-- Password Input and Action Buttons Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Input Box -->
                                    <Border Grid.Column="0"
                                        Background="{DynamicResource BgInputBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CompactCornerRadius}"
                                        Height="30"
                                        Margin="0,0,6,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Column="0"
                                                Data="{StaticResource IconKey}"
                                                Fill="{DynamicResource TextMutedBrush}"
                                                Width="12" Height="12"
                                                Stretch="Uniform"
                                                VerticalAlignment="Center"
                                                Margin="10,0,4,0" />

                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <TextBox x:Name="NewArchivePasswordTextBox"
                                                    Text="{Binding NewArchivePasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                                    KeyDown="NewArchivePasswordTextBox_KeyDown"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                    FontSize="12"
                                                    Padding="4,0,8,0"
                                                    VerticalContentAlignment="Center">
                                                </TextBox>

                                                <TextBlock Text="{loc:Loc Settings_ArchivePasswords_Placeholder}"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Margin="6,0,0,0"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding HasNewArchivePasswordInput, Converter={StaticResource InverseBoolToVisConverter}}" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Add Button -->
                                    <Button Grid.Column="1"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Command="{Binding AddArchivePasswordCommand}"
                                        IsEnabled="{Binding CanAddArchivePassword}"
                                        Height="30"
                                        Margin="0,0,6,0"
                                        ToolTip="{loc:Loc Settings_ArchivePasswords_Add}"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconPlus}"
                                                Fill="{DynamicResource AccentBlueBrush}"
                                                Width="10" Height="10"
                                                Stretch="Uniform"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" />
                                            <TextBlock Text="{loc:Loc Settings_ArchivePasswords_Add}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Saved Count Toggle Button -->
                                    <Button Grid.Column="2"
                                        Style="{StaticResource ArchivePasswordToggleButtonStyle}"
                                        Command="{Binding ToggleArchivePasswordsExpandedCommand}"
                                        ToolTip="{loc:Loc Settings_ArchivePasswords_Toggle_ToolTip}"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <!-- Expandable Passwords List -->
                                <helpers:AnimatedExpansionDecorator IsExpanded="{Binding IsArchivePasswordsExpanded}" EnableAnimation="True">
                                    <Border Background="{DynamicResource BgInputBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CompactCornerRadius}"
                                        ClipToBounds="True"
                                        Margin="0,8,0,0">
                                        <Grid>
                                            <!-- Empty State -->
                                            <StackPanel Visibility="{Binding HasArchivePasswords, Converter={StaticResource InverseBoolToVisConverter}}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,20">
                                                <Path Data="{StaticResource IconKey}"
                                                    Fill="{DynamicResource TextMutedBrush}"
                                                    Width="22" Height="22"
                                                    Stretch="Uniform"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,8"
                                                    Opacity="0.45" />
                                                <TextBlock Text="{loc:Loc Settings_ArchivePasswords_Empty}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    HorizontalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc Settings_ArchivePasswords_Empty_Detail}"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    HorizontalAlignment="Center"
                                                    Margin="16,4,16,0"
                                                    TextWrapping="Wrap"
                                                    TextAlignment="Center"
                                                    Opacity="0.75" />
                                            </StackPanel>

                                            <!-- Passwords List -->
                                            <Grid Visibility="{Binding HasArchivePasswords, Converter={StaticResource BoolToVisConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Background="{DynamicResource BgHeaderBrush}" Padding="12,8"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                                                    <Grid TextBlock.FontSize="11" TextBlock.FontWeight="SemiBold"
                                                        TextBlock.Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="21" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="65" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="10" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.ColumnSpan="2" Text="{loc:Loc Settings_ArchivePasswords_Column_Password}" />
                                                        <TextBlock Grid.Column="2" Text="{loc:Loc Settings_ArchivePasswords_Column_Added}" Margin="8,0" />
                                                        <TextBlock Grid.Column="3" Text="{loc:Loc Settings_ArchivePasswords_Column_Used}" HorizontalAlignment="Right" Margin="8,0"
                                                            ToolTip="{loc:Loc Settings_ArchivePasswords_Usage_ToolTip}" />
                                                        <TextBlock Grid.Column="4" Text="{loc:Loc Settings_ArchivePasswords_Column_Success}" HorizontalAlignment="Right" Margin="8,0"
                                                            ToolTip="{loc:Loc Settings_ArchivePasswords_Success_ToolTip}" />
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer x:Name="ArchivePasswordsScrollViewer" Grid.Row="1" MaxHeight="220" helpers:ModernScrollThumb.Compact="True"
                                                    VerticalScrollBarVisibility="Visible"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    Focusable="False"
                                                    Visibility="{Binding HasArchivePasswords, Converter={StaticResource BoolToVisConverter}}">
                                                    <ItemsControl ItemsSource="{Binding ArchivePasswordEntries}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="Transparent"
                                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="12,7">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="21" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="130" />
                                                                            <ColumnDefinition Width="65" />
                                                                            <ColumnDefinition Width="90" />
                                                                            <ColumnDefinition Width="60" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Subtle key icon bullet -->
                                                                        <Path Grid.Column="0"
                                                                            Data="{StaticResource IconKey}"
                                                                            Fill="{DynamicResource TextSecondaryBrush}"
                                                                            Width="11" Height="11"
                                                                            Stretch="Uniform"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,10,0"
                                                                            Opacity="0.65" />

                                                                        <!-- Password Text in clean monospace style -->
                                                                        <TextBlock Grid.Column="1"
                                                                            Text="{Binding Password}"
                                                                            FontFamily="Consolas, Cascadia Code, Segoe UI Mono, monospace"
                                                                            FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                                                            VerticalAlignment="Center"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            ToolTip="{Binding Password}" />

                                                                        <TextBlock Grid.Column="2" Text="{Binding AddedAtText}" Margin="8,0" FontSize="11"
                                                                            VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding AddedAtText}"
                                                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                        <TextBlock Grid.Column="3" Text="{Binding UsageCount}" Margin="8,0" FontSize="11.5"
                                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                            ToolTip="{loc:Loc Settings_ArchivePasswords_Usage_ToolTip}" />
                                                                        <TextBlock Grid.Column="4" Text="{Binding SuccessCount}" Margin="8,0" FontSize="11.5"
                                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                            ToolTip="{loc:Loc Settings_ArchivePasswords_Success_ToolTip}" />

                                                                        <!-- Action Buttons: Copy & Remove -->
                                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <!-- Copy Button -->
                                                                            <Button Command="{Binding DataContext.CopyArchivePasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Password}"
                                                                                Style="{StaticResource PasswordActionButtonStyle}"
                                                                                ToolTip="{loc:Loc Settings_ArchivePasswords_Copy}"
                                                                                Width="28" Height="26"
                                                                                Margin="0,0,4,0">
                                                                                <Path Data="{StaticResource IconCopy}"
                                                                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                    Width="12" Height="12"
                                                                                    Stretch="Uniform"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />
                                                                            </Button>

                                                                            <!-- Remove Button (red hover) -->
                                                                            <Button Command="{Binding DataContext.RemoveArchivePasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Password}"
                                                                                Style="{StaticResource PasswordDeleteButtonStyle}"
                                                                                ToolTip="{loc:Loc Settings_ArchivePasswords_Remove}"
                                                                                Width="28" Height="26">
                                                                                <Path Data="{StaticResource IconTrash}"
                                                                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                    Width="12" Height="12"
                                                                                    Stretch="Uniform"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </helpers:AnimatedExpansionDecorator>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ******************** CATEGORY 3: KEYBOARD SHORTCUTS ******************** -->
                <StackPanel x:Name="CategoryShortcuts"
                    IsVisibleChanged="Category_IsVisibleChanged"
                    Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Shortcuts'}"
                    RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>
                    <TextBlock Style="{StaticResource SettingsPageHeadingStyle}" Text="{loc:Loc Settings_Category_Shortcuts}" />

                    <!-- Shortcuts List -->
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CompactCornerRadius}"
                                    Padding="16,12"
                                    Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Title & Description -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Shortcut Key Button & Reset Button -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Key Binding Button -->
                                            <Button Command="{Binding DataContext.StartRecordingShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Padding="12,5"
                                                MinWidth="110">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="helpers:ControlMotion.PressFeedback" Value="True" />
                                                        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="BtnBorder"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="{DynamicResource CompactCornerRadius}"
                                                                        Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <!-- Normal Key Display -->
                                                    <TextBlock Text="{Binding DisplayGesture}"
                                                        FontWeight="SemiBold"
                                                        FontSize="11.5"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Recording Prompt -->
                                                    <TextBlock Text="{loc:Loc Settings_Shortcuts_RecordingPrompt}"
                                                        FontWeight="Bold"
                                                        FontSize="11.5"
                                                        Foreground="{DynamicResource AccentForegroundBrush}"
                                                        HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Button>

                                            <!-- Reset Single Shortcut Button (Visible only when customized) -->
                                            <Button Command="{Binding DataContext.ResetShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:Loc Settings_Shortcuts_ResetOne}"
                                                Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                                                Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                        <Setter Property="helpers:ControlMotion.PressFeedback" Value="True" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ******************** CATEGORY 4: ABOUT ******************** -->
                <StackPanel x:Name="CategoryAbout"
                    IsVisibleChanged="Category_IsVisibleChanged"
                    Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='About'}"
                    RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>

                    <!-- Centered Header (Logo without background, Name, Version as pure blue text) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,6,0,22">
                        <Border x:Name="AboutLogo" Background="{DynamicResource AboutLogoBrush}"
                            Width="68" Height="68"
                            SnapsToDevicePixels="True"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                            <Border.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/Reepax;component/Assets/R.png" Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>

                        <TextBlock Text="Reepax"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,3" />

                        <!-- Version as pure blue text without box/border/background -->
                        <TextBlock Text="{Binding AppDisplayVersion}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentBlueBrush}"
                            HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Section 1: System & Laufzeitumgebung (Diagnostics) -->
                    <Border Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc About_SystemDiagnostics_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                            <!-- OS -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_OS_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding OperatingSystemInfo}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Runtime -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_Runtime_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DotNetRuntimeInfo}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Architecture -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_Architecture_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ArchitectureInfo}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Native Engine -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_NativeEngine_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc About_NativeEngine_Value}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Archive & Repair Engine -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_ArchiveEngine_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc About_ArchiveEngine_Value}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Storage & Directories -->
                    <Border Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc About_Directories_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                            <!-- AppData Path -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_AppDataFolder_Label}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding AppDataFolderPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                    Command="{Binding OpenAppDataFolderInExplorerCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_OpenFolder_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,8,0,10" />

                            <!-- Logs Path -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_LogsFolder_Label}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding LogsFolderPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                    Command="{Binding OpenLogsFolderInExplorerCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_OpenFolder_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,8,0,10" />

                            <!-- Downloads Path -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_DownloadsFolder_Label}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CurrentDownloadDirectory}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                    Command="{Binding OpenDefaultDownloadFolderCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_OpenFolder_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Contributors -->
                    <Border Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Header: Contributors Title + (i) ToolTip -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconHeart}" Fill="{DynamicResource AccentBlueBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Loc About_Contributors_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                    <!-- (i) Info icon explaining merged PR requirement -->
                                    <Border Margin="8,0,0,0"
                                        Background="Transparent"
                                        Cursor="Help"
                                        ToolTipService.InitialShowDelay="50"
                                        ToolTipService.ShowDuration="15000"
                                        VerticalAlignment="Center">
                                        <Border.ToolTip>
                                            <ToolTip MaxWidth="380">
                                                <StackPanel Margin="2">
                                                    <TextBlock Text="{loc:Loc About_Contributors_Notice_Title}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,0,4" />
                                                    <TextBlock Text="{loc:Loc About_Contributors_Notice}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <Path Data="{StaticResource IconInfo}"
                                            Width="13" Height="13"
                                            Fill="{DynamicResource AccentBlueBrush}"
                                            Stretch="Uniform"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <!-- 4 Columns of Contributors (Name + Link + Crown, No Logos) -->
                            <ItemsControl ItemsSource="{Binding Contributors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgInputBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="10,8"
                                            Margin="3,3">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Small Royal Crown for Biiitz -->
                                                <Path x:Name="CrownIcon"
                                                    Data="{StaticResource IconCrown}"
                                                    Width="13" Height="13"
                                                    Stretch="Uniform"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{loc:Loc About_Contributor_CrownToolTip}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCrown}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                    <Path.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FDE047" Offset="0.0" />
                                                            <GradientStop Color="#EAB308" Offset="0.5" />
                                                            <GradientStop Color="#B45309" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Path.Fill>
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-12" CenterX="6.5" CenterY="6.5" />
                                                    </Path.RenderTransform>
                                                </Path>

                                                <!-- Clickable GitHub Name Only (Not the entire bar) -->
                                                <Button Command="{Binding DataContext.OpenContributorProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding ProfileUrl}"
                                                    ToolTip="{Binding ProfileUrl}"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                                                                <TextBlock x:Name="NameText"
                                                                    Text="{Binding Username}"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                                    VerticalAlignment="Center"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <Path x:Name="LinkIcon"
                                                                    Data="{StaticResource IconExternalLink}"
                                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                                    Width="9" Height="9"
                                                                    Stretch="Uniform"
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Opacity="0.6" />
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentBlueBrush}" />
                                                                    <Setter TargetName="LinkIcon" Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                                    <Setter TargetName="LinkIcon" Property="Opacity" Value="1.0" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Section 4: Developer & Links -->
                    <Border Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_Developer_Label}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{loc:Loc About_Developer_Value}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Copyright © 2026 Biiitz" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </DockPanel>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Command="{Binding OpenGitHubRepositoryCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGitHub}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_Links_Repository}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenGitHubReleasesCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconHistory}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_Links_Releases}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenGitHubIssuesCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExternalLink}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_Links_Issues}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenGitHubContributingCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGitHub}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_Community_ContributeButton}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
