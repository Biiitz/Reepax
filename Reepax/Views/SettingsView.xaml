                                            </StackPanel>

                                            <!-- Right: Volume Control with Speaker Icon, Slider & Percentage Badge -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Speaker Icon -->
                                                <Path Data="{StaticResource IconVolume}"
                                                    Width="14"
                                                    Height="14"
                                                    Stretch="Uniform"
                                                    Fill="{DynamicResource TextSecondaryBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0" />

                                                <!-- Sleek Fluent Slider -->
                                                <Slider Style="{StaticResource ModernVolumeSliderStyle}"
                                                    Width="130"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    SmallChange="5"
                                                    LargeChange="10"
                                                    Value="{Binding CompletionSoundVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    PreviewMouseUp="CompletionSoundVolumeSlider_PreviewMouseUp"
                                                    MouseWheel="CompletionSoundVolumeSlider_MouseWheel"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand" />

                                                <!-- Percentage Value Badge -->
                                                <Border Background="{DynamicResource BgInputBrush}"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource CompactCornerRadius}"
