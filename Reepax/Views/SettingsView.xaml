                                    <helpers:ChoiceOption Value="{x:Static models:CompletionSoundTrigger.EntirePackage}" Text="{loc:Loc Settings_Sound_Trigger_EntirePackage}" />
                                    <helpers:ChoiceOption Value="{x:Static models:CompletionSoundTrigger.IndividualFiles}" Text="{loc:Loc Settings_Sound_Trigger_IndividualFiles}" />
                                </helpers:SingleChoiceDropdown>

                                        <!-- Top Sub-Row: Sound Selector & Volume Slider -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="Auto" />
