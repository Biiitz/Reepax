<UserControl x:Class="Reepax.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Reepax.ViewModels"
             xmlns:loc="clr-namespace:Reepax.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Background="{DynamicResource BgDarkBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <!-- Category Sidebar Item Base Style -->
        <Style x:Key="SettingsCategoryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgInputBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button in Settings -->
        <Style x:Key="SettingsActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BgCardAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgInputBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgCardBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Category Sidebar -->
            <ColumnDefinition Width="236" />
            <!-- Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT CATEGORY SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgHeaderBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="0,0,1,0">
            <!-- Category List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12">
                    <StackPanel>
                        <!-- 1. General -->
                        <Button Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="General">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="General">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Notifications">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="0" Margin="0,2,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="General">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Notifications">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconSliders}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="General">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Notifications">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_General}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- 2. Downloads & Connections -->
                        <Button Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="DownloadConnections">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="DownloadConnections">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="0" Margin="0,2,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="DownloadConnections">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconDownload}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="DownloadConnections">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_Downloads}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>
                        <!-- 3. Keyboard Shortcuts -->
                        <Button Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="Shortcuts">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Shortcuts">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="0" Margin="0,2,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Shortcuts">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconKeyboard}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Shortcuts">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_Shortcuts}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
        </Border>

        <!-- ==================== RIGHT CONTENT PANE ==================== -->
        <ScrollViewer x:Name="SettingsContentScrollViewer"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      Background="{DynamicResource BgDarkBrush}"
                      PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
            <Grid Margin="32,28,40,32" HorizontalAlignment="Stretch">

                <!-- ******************** CATEGORY 1: GENERAL ******************** -->
                <StackPanel x:Name="CategoryGeneral"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='General|Notifications'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>
                    <!-- Language -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Language_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_Language_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="{loc:Loc Settings_Language_English}"
                                         IsChecked="{Binding IsEnglishSelected, Mode=TwoWay}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Margin="0,0,14,0"
                                         Cursor="Hand" />
                            <RadioButton Content="{loc:Loc Settings_Language_German}"
                                         IsChecked="{Binding IsGermanSelected, Mode=TwoWay}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Cursor="Hand" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_StartWithWindows_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_StartWithWindows_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Benachrichtigungen aktivieren -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Notifications_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_Notifications_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding EnableCompletionNotifications, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Automatically collapse completed packages -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_AutoCollapse_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_AutoCollapse_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding AutoCollapseCompletedPackages, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Dateiprotokolle (Logs in AppData) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_EnableLogging_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_EnableLogging_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding EnableFileLogging, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>
                </StackPanel>

                <!-- ******************** CATEGORY 2: DOWNLOADS & CONNECTIONS ******************** -->
                <StackPanel x:Name="CategoryDownloadConnections"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='DownloadConnections'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>

                    <!-- Speed limit (MB/s) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_SpeedLimit_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_SpeedLimit_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="0" Height="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SpeedLimitText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="NumericSpinner"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         Padding="6,2"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         PreviewMouseWheel="SpeedLimit_PreviewMouseWheel" />
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                             <RowDefinition Height="*" />
                                             <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Command="{Binding IncrementSpeedLimitCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Row="1" Command="{Binding DecrementSpeedLimitCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource BgCardAltBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0" CornerRadius="0" Padding="8,2">
                                    <TextBlock Text="MB/s" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- Maximum concurrent downloads -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_ConcurrentDownloads_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_ConcurrentDownloads_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="0" Height="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding MaxConcurrentDownloadsText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="NumericSpinner"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         Padding="4,2"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         PreviewMouseWheel="MaxDownloads_PreviewMouseWheel" />
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Command="{Binding IncrementMaxDownloadsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Row="1" Command="{Binding DecrementMaxDownloadsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- Connections per download (chunks) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Connections_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_Connections_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="0" Height="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ConnectionsPerDownloadText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="NumericSpinner"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         Padding="4,2"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         PreviewMouseWheel="Connections_PreviewMouseWheel" />
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Command="{Binding IncrementConnectionsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Row="1" Command="{Binding DecrementConnectionsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- ==================== SPIEL-INSTALLATIONSORDNER ==================== -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_GameInstall_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_GameInstall_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding CreateGameInstallFolder, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <!-- Path selection (only visible when option is active) -->
                    <Grid Margin="0,4,0,0" Visibility="{Binding CreateGameInstallFolder, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:Loc Settings_GameInstall_PathSubtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="0" Height="30" Margin="0,0,8,0">
                                <TextBox Text="{Binding GameInstallDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         Padding="10,0"
                                         FontSize="12"
                                         VerticalContentAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Command="{Binding BrowseGameInstallDirectoryCommand}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource AccentBlueBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Loc Common_Browse}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Command="{Binding OpenGameInstallDirectoryCommand}"
                                    ToolTip="{Binding GameInstallDirectory}"
                                    VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- ==================== PAR2 AUTO-REPAIR ==================== -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_AutoPar2Repair_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_AutoPar2Repair_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding AutoPar2Repair, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- PAR2 Cleanup -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_DeletePar2AfterExtraction_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_DeletePar2AfterExtraction_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding DeletePar2AfterExtraction, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>
                </StackPanel>

                <!-- ******************** CATEGORY 3: KEYBOARD SHORTCUTS ******************** -->
                <StackPanel x:Name="CategoryShortcuts"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Shortcuts'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>

                    <!-- Shortcuts List -->
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        Padding="16,12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Title & Description -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Shortcut Key Button & Reset Button -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Key Binding Button -->
                                            <Button Command="{Binding DataContext.StartRecordingShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Padding="12,5"
                                                    MinWidth="110">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="BtnBorder"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="0"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <!-- Normal Key Display -->
                                                    <TextBlock Text="{Binding DisplayGesture}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Recording Prompt -->
                                                    <TextBlock Text="{loc:Loc Settings_Shortcuts_RecordingPrompt}"
                                                               FontWeight="Bold"
                                                               FontSize="11.5"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Button>

                                            <!-- Reset Single Shortcut Button (Visible only when customized) -->
                                            <Button Command="{Binding DataContext.ResetShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{loc:Loc Settings_Shortcuts_ResetOne}"
                                                    Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
