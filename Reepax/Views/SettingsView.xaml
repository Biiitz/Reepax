<UserControl x:Class="Reepax.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Reepax.ViewModels"
             xmlns:loc="clr-namespace:Reepax.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Background="{DynamicResource BgDarkBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <!-- Category Sidebar Item Base Style -->
        <Style x:Key="SettingsCategoryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgInputBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button in Settings -->
        <Style x:Key="SettingsActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BgCardAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgInputBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgCardBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Category Sidebar -->
            <ColumnDefinition Width="236" />
            <!-- Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT CATEGORY SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgHeaderBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="0,0,1,0">
            <!-- Category List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12">
                <Grid x:Name="CategoryButtonsContainer">
                    <StackPanel x:Name="CategoryButtonsPanel">
                        <!-- 1. General -->
                        <Button x:Name="GeneralCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="General">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="General">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Notifications">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconSliders}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="General">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Notifications">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_General}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- 2. Downloads & Connections -->
                        <Button x:Name="DownloadsCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="DownloadConnections">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="DownloadConnections">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconDownload}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="DownloadConnections">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_Downloads}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- 3. Keyboard Shortcuts -->
                        <Button x:Name="ShortcutsCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="Shortcuts">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Shortcuts">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconKeyboard}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Shortcuts">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_Shortcuts}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- 4. About -->
                        <Button x:Name="AboutCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}"
                                CommandParameter="About">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="About">
                                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Margin="6,0,0,0" Data="{StaticResource IconInfo}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="About">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings_Category_About}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Animated Sliding Blue Pill Indicator -->
                    <Border x:Name="SlidingCategoryIndicator"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="3"
                            Height="18"
                            CornerRadius="1.5"
                            Background="{DynamicResource AccentBlueBrush}"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CategoryIndicatorTransform" X="18" Y="10" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Direction="0" ShadowDepth="0" BlurRadius="6" Color="#38BDF8" Opacity="0.25" />
                        </Border.Effect>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ==================== RIGHT CONTENT PANE ==================== -->
        <ScrollViewer x:Name="SettingsContentScrollViewer"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      Background="{DynamicResource BgDarkBrush}"
                      PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
            <Grid Margin="32,28,40,32" HorizontalAlignment="Stretch">

                <!-- ******************** CATEGORY 1: GENERAL ******************** -->
                <StackPanel x:Name="CategoryGeneral"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='General|Notifications'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>
                    <!-- Language -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Language_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_Language_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="{loc:Loc Settings_Language_English}"
                                         IsChecked="{Binding IsEnglishSelected, Mode=TwoWay}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Margin="0,0,14,0"
                                         Cursor="Hand" />
                            <RadioButton Content="{loc:Loc Settings_Language_German}"
                                         IsChecked="{Binding IsGermanSelected, Mode=TwoWay}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Cursor="Hand" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,8" Opacity="{Binding IsStartWithWindowsEnabled, Converter={StaticResource BoolToOpacityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_StartWithWindows_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_StartWithWindows_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="{loc:Loc Settings_StartWithWindows_PortableDisabled}" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" FontStyle="Italic" Margin="0,2,0,0" Visibility="{Binding IsPortableMode, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsEnabled="{Binding IsStartWithWindowsEnabled}"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- In Infobereich minimieren beim Schließen -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_MinimizeToTrayOnClose_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_MinimizeToTrayOnClose_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Benachrichtigungen aktivieren -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Notifications_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_Notifications_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding EnableCompletionNotifications, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Automatically collapse completed packages -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_AutoCollapse_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_AutoCollapse_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding AutoCollapseCompletedPackages, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,18,0,18" />

                    <!-- Dateiprotokolle (Logs in AppData) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_EnableLogging_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_EnableLogging_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding EnableFileLogging, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>
                </StackPanel>

                <!-- ******************** CATEGORY 2: DOWNLOADS & CONNECTIONS ******************** -->
                <StackPanel x:Name="CategoryDownloadConnections"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='DownloadConnections'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>

                    <!-- Speed limit (MB/s) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_SpeedLimit_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_SpeedLimit_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" ClipToBounds="True">
                                    <TextBlock x:Name="SpeedLimitGhostText"
                                               Text=""
                                               Opacity="0"
                                               Background="Transparent"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Padding="6,2"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="SpeedLimitGhostTranslate" Y="0" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBox x:Name="SpeedLimitBox"
                                             Text="{Binding SpeedLimitText, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="NumericSpinner"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             Padding="6,2"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             HorizontalContentAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             PreviewMouseWheel="SpeedLimit_PreviewMouseWheel"
                                             TextChanged="SpeedLimitBox_TextChanged">
                                        <TextBox.RenderTransform>
                                            <TranslateTransform x:Name="SpeedLimitTranslate" Y="0" />
                                        </TextBox.RenderTransform>
                                    </TextBox>
                                </Grid>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                             <RowDefinition Height="*" />
                                             <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Command="{Binding IncrementSpeedLimitCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Row="1" Command="{Binding DecrementSpeedLimitCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource BgCardAltBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="MB/s" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- Maximum concurrent downloads -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_ConcurrentDownloads_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_ConcurrentDownloads_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" ClipToBounds="True">
                                    <TextBlock x:Name="MaxDownloadsGhostText"
                                               Text=""
                                               Opacity="0"
                                               Background="Transparent"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Padding="4,2"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="MaxDownloadsGhostTranslate" Y="0" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBox x:Name="MaxDownloadsBox"
                                             Text="{Binding MaxConcurrentDownloadsText, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="NumericSpinner"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             Padding="4,2"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             PreviewMouseWheel="MaxDownloads_PreviewMouseWheel"
                                             TextChanged="MaxDownloadsBox_TextChanged">
                                        <TextBox.RenderTransform>
                                            <TranslateTransform x:Name="MaxDownloadsTranslate" Y="0" />
                                        </TextBox.RenderTransform>
                                    </TextBox>
                                </Grid>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Command="{Binding IncrementMaxDownloadsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Row="1" Command="{Binding DecrementMaxDownloadsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- Connections per download (chunks) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_Connections_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_Connections_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" ClipToBounds="True">
                                    <TextBlock x:Name="ConnectionsGhostText"
                                               Text=""
                                               Opacity="0"
                                               Background="Transparent"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Padding="4,2"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="ConnectionsGhostTranslate" Y="0" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBox x:Name="ConnectionsBox"
                                             Text="{Binding ConnectionsPerDownloadText, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="NumericSpinner"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             Padding="4,2"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             PreviewMouseWheel="Connections_PreviewMouseWheel"
                                             TextChanged="ConnectionsBox_TextChanged">
                                        <TextBox.RenderTransform>
                                            <TranslateTransform x:Name="ConnectionsTranslate" Y="0" />
                                        </TextBox.RenderTransform>
                                    </TextBox>
                                </Grid>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Command="{Binding IncrementConnectionsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Row="1" Command="{Binding DecrementConnectionsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- ==================== SPIEL-INSTALLATIONSORDNER ==================== -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_GameInstall_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_GameInstall_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding CreateGameInstallFolder, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <!-- Path selection -->
                    <Border x:Name="GameInstallPathContainer"
                            ClipToBounds="True"
                            Focusable="False">
                        <Grid Margin="0,4,0,0" x:Name="GameInstallPathContent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="GameInstallPathTranslate" Y="0" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{loc:Loc Settings_GameInstall_PathSubtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="30" Margin="0,0,8,0">
                                    <TextBox Text="{Binding GameInstallDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             Padding="10,0"
                                             FontSize="12"
                                             VerticalContentAlignment="Center" />
                                </Border>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Command="{Binding BrowseGameInstallDirectoryCommand}"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource AccentBlueBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc Common_Browse}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Command="{Binding OpenGameInstallDirectoryCommand}"
                                        ToolTip="{Binding GameInstallDirectory}"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- ==================== PAR2 AUTO-REPAIR ==================== -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_AutoPar2Repair_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_AutoPar2Repair_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding AutoPar2Repair, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                    <!-- PAR2 Cleanup -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_DeletePar2AfterExtraction_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc Settings_DeletePar2AfterExtraction_Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding DeletePar2AfterExtraction, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand" />
                    </Grid>
                </StackPanel>

                <!-- ******************** CATEGORY 3: KEYBOARD SHORTCUTS ******************** -->
                <StackPanel x:Name="CategoryShortcuts"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Shortcuts'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>

                    <!-- Shortcuts List -->
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="16,12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Title & Description -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Shortcut Key Button & Reset Button -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Key Binding Button -->
                                            <Button Command="{Binding DataContext.StartRecordingShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Padding="12,5"
                                                    MinWidth="110">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="BtnBorder"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <!-- Normal Key Display -->
                                                    <TextBlock Text="{Binding DisplayGesture}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Recording Prompt -->
                                                    <TextBlock Text="{loc:Loc Settings_Shortcuts_RecordingPrompt}"
                                                               FontWeight="Bold"
                                                               FontSize="11.5"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Button>

                                            <!-- Reset Single Shortcut Button (Visible only when customized) -->
                                            <Button Command="{Binding DataContext.ResetShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{loc:Loc Settings_Shortcuts_ResetOne}"
                                                    Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ******************** CATEGORY 4: ABOUT ******************** -->
                <StackPanel x:Name="CategoryAbout"
                            IsVisibleChanged="Category_IsVisibleChanged"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='About'}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>

                    <!-- Centered Header (Logo without background, Name, Version as pure blue text) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,6,0,22">
                        <Image Source="pack://application:,,,/Reepax;component/Assets/R.png" 
                               Width="68" Height="68" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,10" />

                        <TextBlock Text="Reepax" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,3" />

                        <!-- Version as pure blue text without box/border/background -->
                        <TextBlock Text="{Binding AppDisplayVersion}" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AccentBlueBrush}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Section 1: System & Laufzeitumgebung (Diagnostics) -->
                    <Border Background="{DynamicResource BgCardBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="20,16" 
                            Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_SystemDiagnostics_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" 
                                        Command="{Binding CopySystemDiagnosticInfoCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_CopyDiagnostics_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- OS -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_OS_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding OperatingSystemInfo}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Runtime -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_Runtime_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DotNetRuntimeInfo}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Architecture -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_Architecture_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ArchitectureInfo}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Native Engine -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_NativeEngine_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc About_NativeEngine_Value}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,6,0,8" />

                            <!-- Archive & Repair Engine -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc About_ArchiveEngine_Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc About_ArchiveEngine_Value}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Storage & Directories -->
                    <Border Background="{DynamicResource BgCardBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="20,16" 
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc About_Directories_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                            <!-- AppData Path -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_AppDataFolder_Label}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding AppDataFolderPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Command="{Binding OpenAppDataFolderInExplorerCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}" 
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_OpenFolder_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,8,0,10" />

                            <!-- Logs Path -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_LogsFolder_Label}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding LogsFolderPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Command="{Binding OpenLogsFolderInExplorerCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}" 
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_OpenFolder_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,8,0,10" />

                            <!-- Downloads Path -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_DownloadsFolder_Label}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CurrentDownloadDirectory}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Command="{Binding OpenDefaultDownloadFolderCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}" 
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_OpenFolder_Button}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Developer & Links -->
                    <Border Background="{DynamicResource BgCardBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc About_Developer_Label}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{loc:Loc About_Developer_Value}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Copyright © 2026 Biiitz" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </DockPanel>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Command="{Binding OpenGitHubRepositoryCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}" 
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGitHub}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_Links_Repository}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenGitHubReleasesCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}" 
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconHistory}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_Links_Releases}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenGitHubIssuesCommand}" 
                                        Style="{StaticResource SettingsActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExternalLink}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc About_Links_Issues}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
