                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_Notifications_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Notifications_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding EnableCompletionNotifications, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />

                            <!-- ==================== 1. COMPLETION SOUND ==================== -->
                            <Grid Margin="0,0,0,8" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
