<UserControl x:Class="Reepax.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Reepax.ViewModels"
    xmlns:models="clr-namespace:Reepax.Models"
    xmlns:loc="clr-namespace:Reepax.Converters"
    xmlns:helpers="clr-namespace:Reepax.Helpers"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Background="{DynamicResource BgDarkBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <ResourceDictionary Source="../Themes/SettingsControls.xaml" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Category Sidebar -->
            <ColumnDefinition Width="236" />
            <!-- Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT CATEGORY SIDEBAR ==================== -->
        <Border Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderDarkBrush}"
            BorderThickness="0,0,1,0">
            <!-- Category List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12">
                <Grid x:Name="CategoryButtonsContainer">
                    <StackPanel x:Name="CategoryButtonsPanel">
                        <Button x:Name="GeneralCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="General"
                                AutomationProperties.Name="{loc:Loc Settings_Category_General}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="General">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconSliders}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="General">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                           Text="{loc:Loc Settings_Category_General}" />
                            </Grid>
                        </Button>
                        <Button x:Name="DownloadsCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="DownloadConnections"
                                AutomationProperties.Name="{loc:Loc Settings_Category_Downloads}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="DownloadConnections">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconDownload}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="DownloadConnections">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                           Text="{loc:Loc Settings_Category_Downloads}" />
                            </Grid>
                        </Button>
                        <Button x:Name="ShortcutsCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Shortcuts"
                                AutomationProperties.Name="{loc:Loc Settings_Category_Shortcuts}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Shortcuts">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconKeyboard}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Shortcuts">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                           Text="{loc:Loc Settings_Category_Shortcuts}" />
                            </Grid>
                        </Button>
                        <Button x:Name="AboutCategoryButton"
                                Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="About"
                                AutomationProperties.Name="{loc:Loc Settings_Category_About}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsCategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="About">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconInfo}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="About">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                           Text="{loc:Loc Settings_Category_About}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <helpers:BranchedNavigationRail x:Name="CategoryBranchRail" Width="36" Margin="6,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    TrackBrush="{DynamicResource TextMutedBrush}"
                                                    ActiveBrush="{DynamicResource AccentBlueBrush}" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ==================== RIGHT CONTENT PANE ==================== -->
        <ScrollViewer x:Name="SettingsContentScrollViewer"
            ScrollChanged="SettingsContentScrollChanged"
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Background="{DynamicResource BgDarkBrush}">
            <Grid Margin="28,26,28,32" HorizontalAlignment="Stretch">

                <!-- ******************** CATEGORY 1: GENERAL ******************** -->
                <StackPanel x:Name="CategoryGeneral"
                    IsVisibleChanged="Category_IsVisibleChanged"
                    Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='General|Notifications'}"
                    RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>
                    <!-- Language -->
                    <TextBlock Style="{StaticResource SettingsPageHeadingStyle}" Text="{loc:Loc Settings_Category_General}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="{loc:Loc Settings_Section_Appearance}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,16,0">
                                    <TextBlock Text="{loc:Loc Settings_Theme_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border x:Name="ThemeInfoIcon" Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Theme_Description}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <helpers:SingleChoiceDropdown x:Name="ThemeSelector" Grid.Column="1"
                                    ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                    SelectedValue="{Binding SelectedThemeId, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Settings_Theme_Title}" />
                            </Grid>
                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,16,0">
                                    <TextBlock Text="{loc:Loc Settings_Language_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_Language_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <helpers:SingleChoiceDropdown x:Name="LanguageSelector" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" Grid.Column="1" AutomationProperties.Name="{loc:Loc Settings_Language_Title}">
                                    <helpers:ChoiceOption Value="en" Text="{loc:Loc Settings_Language_English}" />
                                    <helpers:ChoiceOption Value="de" Text="{loc:Loc Settings_Language_German}" />
                                </helpers:SingleChoiceDropdown>
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" Visibility="{Binding CanCustomizeAccent, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Custom accent controls belong to themes that support them. -->
                            <Grid Margin="0,0,0,8" Visibility="{Binding CanCustomizeAccent, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_AccentColor_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_AccentColor_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>

                                <!-- Swatch Button to toggle Palette -->
                                <Button Grid.Column="1"
                                    Command="{Binding ToggleColorPaletteCommand}"
                                    Style="{StaticResource AccentColorButtonStyle}"
                                    Height="30"
                                    Padding="8,4"
                                    Cursor="Hand"
                                    ToolTip="{loc:Loc Settings_AccentColor_ToggleTooltip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="16" Height="16" CornerRadius="{DynamicResource SurfaceCornerRadius}" Background="{Binding CurrentAccentBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding CurrentAccentColor}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Path helpers:ControlMotion.IsExpanded="{Binding IsColorPaletteOpen}" Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="7" Height="4" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Expandable Color Palette Panel -->
                            <helpers:AnimatedExpansionDecorator IsExpanded="{Binding IsColorPaletteOpen}" EnableAnimation="True"
                                Visibility="{Binding CanCustomizeAccent, Converter={StaticResource BoolToVisConverter}}">
                                <Border x:Name="ColorPaletteContainer" Padding="0,12,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: 2D Saturation / Value Box + Rainbow Hue Slider -->
                                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                                                <Grid x:Name="SpectrumBox"
                                                    Width="260"
                                                    Height="150"
                                                    ClipToBounds="True"
                                                    Cursor="Cross"
                                                    Background="Transparent"
                                                    MouseDown="SpectrumBox_MouseDown"
                                                    MouseMove="SpectrumBox_MouseMove"
                                                    MouseUp="SpectrumBox_MouseUp">
                                                    <!-- Base Hue -->
                                                    <Rectangle Fill="{Binding PureHueBrush}" />
                                                    <!-- Saturation (White to Transparent) -->
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <!-- Value / Brightness (Transparent to Black) -->
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0" />
                                                                <GradientStop Color="#FF000000" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <!-- Draggable color marker. -->
                                                    <Canvas IsHitTestVisible="False">
                                                        <Rectangle x:Name="SpectrumThumb" Width="14" Height="14"
                                                            Stroke="White" StrokeThickness="2">
                                                            <Rectangle.Effect>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" Opacity="0.9" />
                                                            </Rectangle.Effect>
                                                        </Rectangle>
                                                    </Canvas>
                                                </Grid>
                                            </Border>

                                            <!-- Hue Slider with Rainbow Track -->
                                            <Grid Margin="0,12,0,0">
                                                <Border Height="12" CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                            <GradientStop Color="#FF0000" Offset="0.0" />
                                                            <GradientStop Color="#FFFF00" Offset="0.167" />
                                                            <GradientStop Color="#00FF00" Offset="0.333" />
                                                            <GradientStop Color="#00FFFF" Offset="0.5" />
                                                            <GradientStop Color="#0000FF" Offset="0.667" />
                                                            <GradientStop Color="#FF00FF" Offset="0.833" />
                                                            <GradientStop Color="#FF0000" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Slider x:Name="HueSlider"
                                                    Style="{StaticResource ModernHueSliderStyle}"
                                                    Minimum="0" Maximum="360"
                                                    Value="{Binding PickerHue, Mode=TwoWay}"
                                                    IsMoveToPointEnabled="True"
                                                    Height="20"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Color values and reset -->
                                        <Grid Grid.Column="1" Height="150" VerticalAlignment="Top">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Color Values: HEX & RGB side-by-side -->
                                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- HEX Input -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{loc:Loc Settings_AccentColor_HexLabel}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding CustomAccentColorHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                        KeyDown="HexTextBox_KeyDown"
                                                        Height="28"
                                                        FontFamily="Consolas, monospace"
                                                        FontWeight="SemiBold"
                                                        FontSize="12"
                                                        Padding="4,0"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center" />
                                                </StackPanel>

                                                <!-- RGB Inputs (R, G, B) -->
                                                <Grid Grid.Column="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Labels R, G, B -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                        Text="{loc:Loc Settings_AccentColor_RedLabel}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,4" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                                        Text="{loc:Loc Settings_AccentColor_GreenLabel}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,4" />
                                                    <TextBlock Grid.Row="0" Grid.Column="4"
                                                        Text="{loc:Loc Settings_AccentColor_BlueLabel}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,4" />

                                                    <!-- TextBoxes for R, G, B -->
                                                    <TextBox Grid.Row="1" Grid.Column="0"
                                                        Text="{Binding ColorR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                        KeyDown="RgbTextBox_KeyDown"
                                                        Height="28"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Padding="0" />
                                                    <TextBox Grid.Row="1" Grid.Column="2"
                                                        Text="{Binding ColorG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                        KeyDown="RgbTextBox_KeyDown"
                                                        Height="28"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Padding="0" />
                                                    <TextBox Grid.Row="1" Grid.Column="4"
                                                        Text="{Binding ColorB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                        KeyDown="RgbTextBox_KeyDown"
                                                        Height="28"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Padding="0" />
                                                </Grid>
                                            </Grid>

                                            <!-- Reset to Default Button -->
                                            <Button Grid.Row="1"
                                                Command="{Binding ResetAccentColorCommand}"
                                                Style="{StaticResource SettingsActionButtonStyle}"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Cursor="Hand"
                                                ToolTip="{loc:Loc Settings_AccentColor_Reset}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconUpdate}"
                                                        Fill="{DynamicResource TextSecondaryBrush}"
                                                        Width="12" Height="12"
                                                        Stretch="Uniform"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock Text="{loc:Loc Settings_AccentColor_Reset}"
                                                        FontSize="11.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </helpers:AnimatedExpansionDecorator>
                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc Settings_SelectionOpacity_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_SelectionOpacity_Help}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="SelectionOpacitySlider" Style="{StaticResource ModernVolumeSliderStyle}" Width="130"
                                        Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding SelectionOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="{loc:Loc Settings_SelectionOpacity_Title}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectionOpacityPercent, StringFormat={}{0:0}%}" Width="40" TextAlignment="Right"
                                        Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc Settings_PixelProgress_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_PixelProgress_Help}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox x:Name="PixelProgressCheckBox" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                    IsChecked="{Binding ShowPixelProgressBars, Mode=TwoWay}"
                                    AutomationProperties.Name="{loc:Loc Settings_PixelProgress_Title}" />
                            </Grid>
                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Overview_Show}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Overview_Help}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <CheckBox x:Name="ShowOverviewCheckBox" Grid.Column="1" IsChecked="{Binding Overview.IsShown, Mode=TwoWay}"
                                    AutomationProperties.Name="{loc:Loc Overview_Show}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="{loc:Loc Settings_Section_Behavior}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="5*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3,20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_PostDownload_Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_PostDownload_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </Grid>
                                <helpers:SingleChoiceDropdown x:Name="PostDownloadActionSelector" SelectedValue="{Binding CurrentPostDownloadAction, Mode=TwoWay}" Grid.Column="1" AutomationProperties.Name="{loc:Loc Settings_PostDownload_Title}">
                                    <helpers:ChoiceOption Value="{x:Static models:PostDownloadAction.None}" Text="{loc:Loc PostDownload_Action_None}" />
                                    <helpers:ChoiceOption Value="{x:Static models:PostDownloadAction.Shutdown}" Text="{loc:Loc PostDownload_Action_Shutdown}" />
