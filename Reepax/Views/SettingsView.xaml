                    IsVisibleChanged="Category_IsVisibleChanged"
                    Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='DownloadConnections'}"
                    RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </StackPanel.RenderTransform>

                    <!-- Speed limit (MB/s) -->
                    <TextBlock Style="{StaticResource SettingsPageHeadingStyle}" Text="{loc:Loc Settings_Category_Downloads}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="{loc:Loc Settings_Section_Transfers}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_SpeedLimit_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_SpeedLimit_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="{DynamicResource CompactCornerRadius}" Height="28">
