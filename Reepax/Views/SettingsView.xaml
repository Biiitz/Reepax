                                                Opacity="0"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Padding="6,2"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="SpeedLimitGhostTranslate" Y="0" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBox x:Name="SpeedLimitBox"
                                                Text="{Binding SpeedLimitText, UpdateSourceTrigger=PropertyChanged}"
                                                Tag="NumericSpinner"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                BorderThickness="0"
                                                Padding="6,2"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                HorizontalContentAlignment="Right"
                                                VerticalContentAlignment="Center"
                                                PreviewMouseWheel="SpeedLimit_PreviewMouseWheel"
                                                TextChanged="SpeedLimitBox_TextChanged">
                                                <TextBox.RenderTransform>
                                                    <TranslateTransform x:Name="SpeedLimitTranslate" Y="0" />
                                                </TextBox.RenderTransform>
                                            </TextBox>
                                        </Grid>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Button Grid.Row="0" Command="{Binding IncrementSpeedLimitCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                    <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                                <Button Grid.Row="1" Command="{Binding DecrementSpeedLimitCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                    <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource BgCardAltBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0" CornerRadius="{DynamicResource CompactCornerRadius}" Padding="8,2">
                                            <TextBlock Text="MB/s" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />

                            <!-- Maximum concurrent downloads -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Settings_ConcurrentDownloads_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SettingInfoIconStyle}" ToolTip="{loc:Loc Settings_ConcurrentDownloads_Subtitle}">
                                        <Path Style="{StaticResource SettingInfoPathStyle}" />
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="{DynamicResource CompactCornerRadius}" Height="28">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="22" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" ClipToBounds="True">
                                            <TextBlock x:Name="MaxDownloadsGhostText"
                                                Text=""
                                                Opacity="0"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Padding="4,2"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="MaxDownloadsGhostTranslate" Y="0" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBox x:Name="MaxDownloadsBox"
                                                Text="{Binding MaxConcurrentDownloadsText, UpdateSourceTrigger=PropertyChanged}"
                                                Tag="NumericSpinner"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                PreviewMouseWheel="MaxDownloads_PreviewMouseWheel"
                                                TextChanged="MaxDownloadsBox_TextChanged">
                                                <TextBox.RenderTransform>
                                                    <TranslateTransform x:Name="MaxDownloadsTranslate" Y="0" />
                                                </TextBox.RenderTransform>
                                            </TextBox>
                                        </Grid>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Button Grid.Row="0" Command="{Binding IncrementMaxDownloadsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                    <Path Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                                <Button Grid.Row="1" Command="{Binding DecrementMaxDownloadsCommand}" Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                    <Path Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,14,0,14" />

