<Window FontFamily="{DynamicResource AppFontFamily}" x:Class="Reepax.Views.ArchivePasswordsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Reepax.Converters"
        Title="{loc:Loc ArchivePasswords_Title}" Width="650" Height="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="pack://application:,,,/Reepax;component/Assets/app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc ArchivePasswords_Title}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc ArchivePasswords_Description}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc ArchivePasswords_Archive}" Margin="0,0,0,5" />
            <ComboBox x:Name="ArchiveSelector" SelectionChanged="ArchiveSelector_SelectionChanged" Padding="8,5" />
            <TextBlock x:Name="ArchiveStatus" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc ArchivePasswords_Input}" Margin="0,0,0,5" />
            <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3">
                <Grid>
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_Changed" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="0,5" />
                    <TextBox x:Name="PasswordReveal" TextChanged="PasswordReveal_Changed" Visibility="Collapsed"
                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="0,5" />
                </Grid>
            </Border>
            <TextBlock Text="{loc:Loc PasswordPrompt_ExactInput}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <CheckBox x:Name="ShowPasswords" Content="{loc:Loc ArchivePasswords_Show}" Click="ShowPasswords_Click" Margin="0,0,0,5" />
            <CheckBox x:Name="ApplyToAll" Content="{loc:Loc ArchivePasswords_AllArchives}" Margin="0,0,0,5" />
            <CheckBox x:Name="RememberPassword" Content="{loc:Loc ArchivePasswords_Remember}" />
        </StackPanel>
        <DataGrid x:Name="CandidateList" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="None" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="CandidateList_SelectionChanged" BorderThickness="1"
                  BorderBrush="{DynamicResource BorderDarkBrush}" Background="{DynamicResource BgCardBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}" RowBackground="{DynamicResource BgCardBrush}"
                  AlternatingRowBackground="{DynamicResource BgDarkBrush}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc ArchivePasswords_Input}" Binding="{Binding Display}" Width="1.2*" />
                <DataGridTextColumn Header="{loc:Loc ArchivePasswords_Source}" Binding="{Binding Source}" Width="*" />
                <DataGridTextColumn Header="{loc:Loc ArchivePasswords_Result}" Binding="{Binding Result}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="5" Margin="0,10,0,12">
            <TextBlock x:Name="CheckStatus" TextWrapping="Wrap" Margin="0,0,0,5" />
            <TextBlock Text="{loc:Loc ArchivePasswords_Session}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <DockPanel Grid.Row="6" LastChildFill="False">
            <Button x:Name="CheckButton" Content="{loc:Loc ArchivePasswords_Check}" Click="CheckButton_Click"
                    Padding="14,7" DockPanel.Dock="Left" />
            <Button x:Name="ContinueButton" Content="{loc:Loc ArchivePasswords_Continue}" Click="ContinueButton_Click"
                    Padding="14,7" DockPanel.Dock="Right" IsDefault="True" Background="{DynamicResource AccentBlueBrush}" />
            <Button Content="{loc:Loc ArchivePasswords_Close}" Click="CloseButton_Click" Padding="14,7"
                    DockPanel.Dock="Right" Margin="0,0,8,0" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
