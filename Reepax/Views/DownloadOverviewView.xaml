<UserControl x:Class="Reepax.Views.DownloadOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Reepax.Helpers"
    xmlns:models="clr-namespace:Reepax.Models"
    xmlns:loc="clr-namespace:Reepax.Converters"
    SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Border Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Thumb x:Name="ResizeHandle" Grid.Row="0" Panel.ZIndex="1" VerticalAlignment="Top" Height="6" Cursor="SizeNS" Focusable="True"
                IsEnabled="{Binding IsExpanded}" DragStarted="ResizeStarted" DragDelta="ResizeDelta" DragCompleted="ResizeCompleted"
                PreviewKeyDown="ResizeKeyDown" ToolTip="{loc:Loc Overview_Resize}" AutomationProperties.Name="{loc:Loc Overview_Resize}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border Width="36" Height="2" Background="{DynamicResource BorderDarkBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Border x:Name="HeaderFrame" Grid.Row="0" Height="41" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Overview_Title}" ToolTip="{loc:Loc Overview_Help}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding CompactSummary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <helpers:SingleChoiceDropdown x:Name="ScopeSelector" SelectedValue="{Binding Scope, Mode=TwoWay}"
                            Style="{DynamicResource PopupButtonStyle}" Height="28" FontSize="12" Padding="10,0" BorderThickness="1" PopupPlacement="Top"
                            AutomationProperties.Name="{loc:Loc Overview_Scope}" Margin="0,0,8,0">
                            <helpers:ChoiceOption Value="{x:Static models:DownloadOverviewScope.All}" Text="{loc:Loc Overview_All}" />
                            <helpers:ChoiceOption Value="{x:Static models:DownloadOverviewScope.Filtered}" Text="{loc:Loc Overview_Filtered}" />
                            <helpers:ChoiceOption Value="{x:Static models:DownloadOverviewScope.Selected}" Text="{loc:Loc Overview_Selected}" />
                        </helpers:SingleChoiceDropdown>
                        <Button x:Name="MetricsButton" Width="28" Height="28" Padding="6" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"
                            Style="{DynamicResource PopupButtonStyle}" Click="OpenMetrics" ToolTip="{loc:Loc Overview_Customize}" AutomationProperties.Name="{loc:Loc Overview_Customize}">
                            <Path Data="{DynamicResource IconSettings}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="10" Height="10" />
                        </Button>
                        <Button x:Name="ExpandButton" Width="28" Height="28" Padding="6" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" Style="{DynamicResource PopupButtonStyle}"
                            Command="{Binding ToggleExpandedCommand}" ToolTip="{loc:Loc Overview_Toggle}" AutomationProperties.Name="{loc:Loc Overview_Toggle}">
                            <Path helpers:ControlMotion.IsExpanded="{Binding IsExpanded}" Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="10" Height="10" />
                        </Button>
                        <Button x:Name="HideButton" Width="28" Height="28" Padding="6" BorderThickness="1" VerticalAlignment="Center" Style="{DynamicResource PopupButtonStyle}"
                            Command="{Binding HideCommand}" ToolTip="{loc:Loc Overview_Hide}" AutomationProperties.Name="{loc:Loc Overview_Hide}">
                            <Path Data="{DynamicResource IconClose}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="10" Height="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <helpers:AnimatedExpansionDecorator x:Name="BodyExpansion" Grid.Row="1" IsExpanded="{Binding IsExpanded}" EnableAnimation="True" DurationMilliseconds="190" CollapseDurationMilliseconds="170">
                <Grid x:Name="Body" Height="72">
                    <ScrollViewer x:Name="MetricsScrollViewer" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisibleMetrics}" Value="False">
                                        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                <Setter Property="Width" Value="18" />
                                <Setter Property="helpers:ModernScrollThumb.Framed" Value="True" />
                            </Style>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding VisibleMetrics}" Margin="12,8,12,8">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Height="26" Margin="0,0,24,0">
                                        <TextBlock Text="{Binding Title, StringFormat='{}{0}:'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" MaxWidth="240"
                                            VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" MaxWidth="260"
                                            VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{loc:Loc Overview_Empty}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="18" TextWrapping="Wrap"
                        Visibility="{Binding HasVisibleMetrics, Converter={StaticResource InverseBoolToVisConverter}}" VerticalAlignment="Center" />
                </Grid>
            </helpers:AnimatedExpansionDecorator>
        </Grid>
    </Border>
</UserControl>
