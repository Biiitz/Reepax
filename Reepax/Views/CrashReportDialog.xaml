<Window x:Class="Reepax.Views.CrashReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Reepax.Converters"
        mc:Ignorable="d"
        Title="{loc:Loc Crash_UnexpectedErrorTitle}"
        Icon="pack://application:,,,/Reepax;component/Assets/app.ico"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <!-- 0: Header with Icon Badge -->
            <RowDefinition Height="Auto" />
            <!-- 1: Error Message Card -->
            <RowDefinition Height="Auto" />
            <!-- 2: Saved Log Location Box -->
            <RowDefinition Height="Auto" />
            <!-- 3: Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header with Red Alert Badge -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="42" Height="42"
                    CornerRadius="10"
                    Background="#2AEE4444"
                    BorderBrush="#88EE4444"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <Path Data="{StaticResource IconWarning}"
                      Fill="#EF4444"
                      Width="20" Height="20"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock"
                           Text="{loc:Loc Crash_UnexpectedErrorTitle}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,3" />
                <TextBlock x:Name="SubtitleTextBlock"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- 1: Error Message Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,16">
            <ScrollViewer MaxHeight="130"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ErrorMessageTextBlock"
                           FontSize="12.5"
                           FontFamily="Consolas, Segoe UI, sans-serif"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="18" />
            </ScrollViewer>
        </Border>

        <!-- 2: Saved Log Location Box -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="{loc:Loc Crash_SavedToLabel}"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />
            <Border Background="{DynamicResource BgInputBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8">
                <TextBox x:Name="LogPathTextBox"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="11.5"
                         FontFamily="Consolas, Segoe UI, sans-serif"
                         TextWrapping="Wrap"
                         Cursor="IBeam" />
            </Border>
        </StackPanel>

        <!-- 3: Action Buttons -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- Open Folder Button -->
                <Button x:Name="OpenFolderButton"
                        Click="OpenFolderButton_Click"
                        Height="32"
                        Padding="12,0"
                        Margin="0,0,8,0"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconFolder}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              Margin="0,0,7,0" />
                        <TextBlock Text="{loc:Loc Crash_OpenFolder}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Copy Path Button -->
                <Button x:Name="CopyPathButton"
                        Click="CopyPathButton_Click"
                        Height="32"
                        Padding="12,0"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="CopyIcon"
                              Data="{StaticResource IconCopy}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Margin="0,0,6,0" />
                        <TextBlock x:Name="CopyTextBlock"
                                   Text="{loc:Loc Crash_CopyPath}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Close Button (Primary/Accent) -->
            <Button x:Name="CloseButton"
                    Click="CloseButton_Click"
                    IsDefault="True"
                    IsCancel="True"
                    Height="32"
                    Padding="20,0"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource AccentBlueBrush}"
                    BorderThickness="0"
                    Foreground="White"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
                <TextBlock Text="{loc:Loc Crash_Close}"
                           FontSize="12.5"
                           FontWeight="SemiBold" />
            </Button>
        </Grid>
    </Grid>
</Window>
