<UserControl x:Class="Reepax.Views.QuickSettingsPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Reepax.ViewModels"
             xmlns:loc="clr-namespace:Reepax.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Width="0" Height="0" Focusable="False">
    <Popup x:Name="PopupRoot"
           Placement="Top"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade"
           VerticalOffset="-13"
           HorizontalOffset="-304"
           Closed="PopupRoot_Closed">
        <Border x:Name="PopupContent"
                Background="{DynamicResource BgCardBrush}" 
                BorderBrush="{DynamicResource BorderDarkBrush}" 
                BorderThickness="1" 
                CornerRadius="4" 
                Padding="16,14" 
                Width="340"
                SnapsToDevicePixels="True" 
                UseLayoutRounding="True">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="{loc:Loc QuickSettings_Title}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,0,0,10" />

                <!-- 1. Geschwindigkeitsbegrenzung (MB/s) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Settings_SpeedLimit_Title}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{loc:Loc Settings_SpeedLimit_Subtitle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" ClipToBounds="True">
                                <TextBlock x:Name="QuickSpeedLimitGhostText"
                                           Text=""
                                           Opacity="0"
                                           Background="Transparent"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Padding="4,1"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="QuickSpeedLimitGhostTranslate" Y="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBox x:Name="QuickSpeedLimitBox"
                                         Text="{Binding SpeedLimitText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" 
                                         Foreground="{DynamicResource TextPrimaryBrush}" 
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0" 
                                         Padding="4,1" 
                                         FontSize="11.5" 
                                         FontWeight="SemiBold" 
                                         HorizontalContentAlignment="Right" 
                                         VerticalContentAlignment="Center" 
                                         PreviewMouseWheel="SpeedLimit_PreviewMouseWheel"
                                         TextChanged="QuickSpeedLimitBox_TextChanged">
                                    <TextBox.RenderTransform>
                                        <TranslateTransform x:Name="QuickSpeedLimitTranslate" Y="0" />
                                    </TextBox.RenderTransform>
                                </TextBox>
                            </Grid>

                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Command="{Binding IncrementSpeedLimitCommand}" 
                                            Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="Transparent">
                                                    <Path x:Name="ArrowPath" Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="6" Height="3" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                        <Setter TargetName="ArrowPath" Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BorderDarkBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Row="1" Command="{Binding DecrementSpeedLimitCommand}" 
                                            Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="Transparent">
                                                    <Path x:Name="ArrowPath" Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="6" Height="3" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                        <Setter TargetName="ArrowPath" Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BorderDarkBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource BgCardAltBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0" CornerRadius="4" Padding="5,2">
                                <TextBlock Text="MB/s" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,2,0,10" />

                <!-- 2. Maximum concurrent downloads -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Settings_ConcurrentDownloads_Title}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{loc:Loc Settings_ConcurrentDownloads_Subtitle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" ClipToBounds="True">
                                <TextBlock x:Name="QuickMaxDownloadsGhostText"
                                           Text=""
                                           Opacity="0"
                                           Background="Transparent"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Padding="2,1"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="QuickMaxDownloadsGhostTranslate" Y="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBox x:Name="QuickMaxDownloadsBox"
                                         Text="{Binding MaxConcurrentDownloadsText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" 
                                         Foreground="{DynamicResource TextPrimaryBrush}" 
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0" 
                                         Padding="2,1" 
                                         FontSize="11.5" 
                                         FontWeight="SemiBold" 
                                         HorizontalContentAlignment="Center" 
                                         VerticalContentAlignment="Center" 
                                         PreviewMouseWheel="MaxDownloads_PreviewMouseWheel"
                                         TextChanged="QuickMaxDownloadsBox_TextChanged">
                                    <TextBox.RenderTransform>
                                        <TranslateTransform x:Name="QuickMaxDownloadsTranslate" Y="0" />
                                    </TextBox.RenderTransform>
                                </TextBox>
                            </Grid>

                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Command="{Binding IncrementMaxDownloadsCommand}" 
                                            Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="Transparent">
                                                    <Path x:Name="ArrowPath" Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="6" Height="3" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Row="1" Command="{Binding DecrementMaxDownloadsCommand}" 
                                            Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="Transparent">
                                                    <Path x:Name="ArrowPath" Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="6" Height="3" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,2,0,10" />

                <!-- 2b. Connections per download (Chunking) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Settings_Connections_Title}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{loc:Loc Settings_Connections_Subtitle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" ClipToBounds="True">
                                <TextBlock x:Name="QuickConnectionsGhostText"
                                           Text=""
                                           Opacity="0"
                                           Background="Transparent"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Padding="2,1"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="QuickConnectionsGhostTranslate" Y="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBox x:Name="QuickConnectionsBox"
                                         Text="{Binding ConnectionsPerDownloadText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" 
                                         Foreground="{DynamicResource TextPrimaryBrush}" 
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0" 
                                         Padding="2,1" 
                                         FontSize="11.5" 
                                         FontWeight="SemiBold" 
                                         HorizontalContentAlignment="Center" 
                                         VerticalContentAlignment="Center" 
                                         PreviewMouseWheel="Connections_PreviewMouseWheel"
                                         TextChanged="QuickConnectionsBox_TextChanged">
                                    <TextBox.RenderTransform>
                                        <TranslateTransform x:Name="QuickConnectionsTranslate" Y="0" />
                                    </TextBox.RenderTransform>
                                </TextBox>
                            </Grid>

                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Command="{Binding IncrementConnectionsCommand}" 
                                            Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="Transparent">
                                                    <Path x:Name="ArrowPath" Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource TextPrimaryBrush}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="6" Height="3" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Row="1" Command="{Binding DecrementConnectionsCommand}" 
                                            Focusable="False" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="Transparent">
                                                    <Path x:Name="ArrowPath" Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource TextPrimaryBrush}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="6" Height="3" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,2,0,10" />

                <!-- Open all settings button -->
                <Button Style="{DynamicResource ModernButtonStyle}"
                        Click="OpenAllSettings_Click"
                        Padding="10,6"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource AccentBlueBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc QuickSettings_OpenAllSettings}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Popup>
</UserControl>
