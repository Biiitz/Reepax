<Window x:Class="Reepax.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Reepax.Converters"
        mc:Ignorable="d"
        Title="{loc:Loc PasswordPrompt_Title}"
        Icon="pack://application:,,,/Reepax;component/Assets/app.ico"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <!-- 0: Header & Message -->
            <RowDefinition Height="Auto" />
            <!-- 1: Archive File Name Chip -->
            <RowDefinition Height="Auto" />
            <!-- 2: Password Input & Reveal Button -->
            <RowDefinition Height="Auto" />
            <!-- 3: Remember Password Checkbox -->
            <RowDefinition Height="Auto" />
            <!-- 4: Action Buttons (Cancel, Extract) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Header & Message -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc PasswordPrompt_Title}"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />
            <TextBlock Text="{loc:Loc PasswordPrompt_Message}"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="18" />
        </StackPanel>

        <!-- 1: Archive File Name Chip -->
        <Border Grid.Row="1"
                x:Name="ArchiveNameBorder"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                Margin="0,0,0,14"
                Visibility="Visible">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconShield}"
                      Fill="{DynamicResource AccentBlueBrush}"
                      Width="13" Height="13"
                      Stretch="Uniform"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center" />
                <TextBlock x:Name="ArchiveNameTextBlock"
                           d:Text="archive_name.rar"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 2: Password Input Box with Peek / Reveal Button -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc PasswordPrompt_PasswordLabel}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />

            <Border Background="{DynamicResource BgInputBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="4,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Masked Password Input -->
                    <PasswordBox Grid.Column="0"
                                 x:Name="PasswordInputBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBlueBrush}"
                                 BorderThickness="0"
                                 Padding="6,6"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 PasswordChanged="PasswordInputBox_PasswordChanged" />

                    <!-- Revealed Plain-Text Input -->
                    <TextBox Grid.Column="0"
                             x:Name="PasswordRevealBox"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBlueBrush}"
                             BorderThickness="0"
                             Padding="6,6"
                             FontSize="13"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             TextChanged="PasswordRevealBox_TextChanged" />

                    <!-- Peek / Reveal Toggle Button -->
                    <Button Grid.Column="1"
                            x:Name="RevealButton"
                            Click="RevealButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,4"
                            Cursor="Hand"
                            Focusable="False"
                            ToolTip="Show / Hide password">
                        <TextBlock x:Name="RevealIcon"
                                   Text="👁"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 3: Remember Password Checkbox -->
        <CheckBox Grid.Row="3"
                  x:Name="RememberCheckBox"
                  Content="{loc:Loc PasswordPrompt_Remember}"
                  FontSize="12"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Margin="0,0,0,18"
                  Cursor="Hand" />

        <!-- 4: Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- Cancel Button -->
            <Button x:Name="CancelButton"
                    Content="{loc:Loc PasswordPrompt_Cancel}"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Style="{DynamicResource ModernButtonStyle}"
                    Padding="18,6"
                    Margin="0,0,8,0"
                    FontSize="12.5" />

            <!-- Extract Button -->
            <Button x:Name="ExtractButton"
                    Content="{loc:Loc PasswordPrompt_Extract}"
                    Click="ExtractButton_Click"
                    IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}"
                    Padding="22,6"
                    FontSize="12.5" />
        </StackPanel>
    </Grid>
</Window>
