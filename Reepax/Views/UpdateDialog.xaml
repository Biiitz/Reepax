<Window x:Class="Reepax.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Reepax.Converters"
        mc:Ignorable="d"
        Title="{loc:Loc UpdateDialog_Title}"
        Icon="pack://application:,,,/Reepax;component/Assets/app.ico"
        Width="600" Height="450"
        MinWidth="360" MinHeight="300"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI Emoji, Segoe UI, sans-serif"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <!-- 0: Version & Metadata Card -->
            <RowDefinition Height="Auto" />
            <!-- 1: Changelog / Release Notes -->
            <RowDefinition Height="*" />
            <!-- 2: Bottom Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 0: VERSION & METADATA CARD ================= -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Version Transition Row -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <!-- Current Version Chip -->
                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc UpdateDialog_CurrentVersion}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CurrentVersionTextBlock" d:Text="26.9.1" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Arrow -->
                    <TextBlock Text="➔" FontSize="12" Foreground="{DynamicResource AccentBlueBrush}" Margin="8,0,8,0" VerticalAlignment="Center" />

                    <!-- New Version Chip -->
                    <Border Background="#1E3B82F6" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc UpdateDialog_NewVersion}" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="NewVersionTextBlock" d:Text="26.9.2" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Metadata Row (Release Date) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconHistory}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc UpdateDialog_ReleaseDate}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ReleaseDateTextBlock" d:Text="25.09.2026" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1: CHANGELOG / RELEASE NOTES ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{loc:Loc UpdateDialog_ChangelogTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />

            <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="0">
                <FlowDocumentScrollViewer x:Name="ChangelogViewer"
                                          FontFamily="Segoe UI Emoji, Segoe UI, sans-serif"
                                          IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="ChangelogViewer_PreviewMouseWheel"
                                          Background="Transparent"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderThickness="0"
                                          Margin="0" />
            </Border>
        </Grid>

        <!-- ================= 2: BOTTOM ACTION BUTTONS ================= -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Later Button -->
                <Button x:Name="LaterButton"
                        Content="{loc:Loc UpdateDialog_Button_Later}"
                        Click="LaterButton_Click"
                        IsCancel="True"
                        Style="{DynamicResource ModernButtonStyle}"
                        Padding="16,6"
                        Margin="0,0,8,0"
                        FontSize="11.5" />

                <!-- Get Update Button (Opens browser for manual setup download) -->
                <Button x:Name="GetUpdateButton"
                        Click="GetUpdateButton_Click"
                        IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}"
                        Padding="18,6"
                        FontSize="11.5"
                        FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconGitHub}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc UpdateDialog_Button_GetUpdate}" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
