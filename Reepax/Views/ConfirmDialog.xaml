<Window x:Class="Reepax.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Reepax.Converters"
        mc:Ignorable="d"
        Title="{loc:Loc Common_Confirmation}"
        Icon="pack://application:,,,/Reepax;component/Assets/app.ico"
        Width="400" 
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#EF4444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#991B1B" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#7F1D1D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <!-- 0: Message Content -->
            <RowDefinition Height="Auto" />
            <!-- 1: Optional Action Checkbox -->
            <RowDefinition Height="Auto" />
            <!-- 2: Action Buttons: Cancel & Confirm -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Message Body -->
        <TextBlock Grid.Row="0" x:Name="MessageTextBlock" 
                   d:Text="Are you sure you want to proceed?" 
                   FontSize="13" 
                   Foreground="{DynamicResource TextPrimaryBrush}" 
                   TextWrapping="Wrap" 
                   LineHeight="20" 
                   Margin="0,2,0,16" />

        <!-- Optional CheckBox (e.g. also delete files from disk) -->
        <CheckBox Grid.Row="1" x:Name="OptionCheckBox"
                  d:Content="Also delete files from disk"
                  FontSize="12"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Margin="0,0,0,18"
                  Visibility="Collapsed" />

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- Cancel Button -->
            <Button x:Name="CancelButton"
                    Content="{loc:Loc Common_No}" 
                    Click="CancelButton_Click" 
                    IsCancel="True" 
                    Style="{DynamicResource ModernButtonStyle}" 
                    Padding="18,6" 
                    Margin="0,0,8,0"
                    FontSize="12.5" />

            <!-- Confirm Button -->
            <Button x:Name="ConfirmButton" 
                    Content="{loc:Loc Common_Yes}" 
                    Click="ConfirmButton_Click" 
                    IsDefault="True" 
                    Style="{StaticResource DangerButtonStyle}" 
                    Padding="22,6" 
                    FontSize="12.5" />
        </StackPanel>
    </Grid>
</Window>
