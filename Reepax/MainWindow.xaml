<Window x:Class="Reepax.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Reepax.ViewModels"
        xmlns:views="clr-namespace:Reepax.Views"
        xmlns:models="clr-namespace:Reepax.Models"
        xmlns:converters="clr-namespace:Reepax.Converters"
        xmlns:loc="clr-namespace:Reepax.Converters"
        xmlns:helpers="clr-namespace:Reepax.Helpers"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='Reepax'}"
        Icon="pack://application:,,,/Reepax;component/Assets/app.ico"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <ContextMenu x:Key="PackageContextMenu" Opened="PackageContextMenu_Opened" Closed="PackageContextMenu_Closed">
            <MenuItem Header="{Binding Status, Converter={StaticResource PlayPauseTooltipConverter}}"
                      Command="{Binding DataContext.TogglePackagePauseCommand, Source={x:Reference RootWindow}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding Status, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='!Completed'}">
                <MenuItem.Icon>
                    <Path Data="{Binding Status, Converter={StaticResource PlayPauseGeometryConverter}}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="{DynamicResource BorderDarkBrush}" Visibility="{Binding Status, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='!Completed'}" />
            <MenuItem x:Name="OpenPackageMenuItem" Tag="OpenPackageMenuItem"
                      Header="{loc:Loc Menu_OpenPackageFolder}" Click="OpenPackageFolder_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconFolderOpen}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu_Rename}" Click="RenamePackage_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconAppLogo}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu_EditPackage}" Click="EditPackage_MenuItem_Click"
                      Visibility="{Binding CanEditPackage, Converter={StaticResource BoolToVisConverter}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconEdit}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu_AddLinksToPackage}" Click="AddLinksToPackage_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu_CopyAllUrls}" Click="CopyPackageUrls_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu_ExportPackage}" Click="ExportPackage_MenuItem_Click"
                      Visibility="{Binding Status, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='!Completed'}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconExport}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu_CreateGameInstallFolder}" Click="CreateGameInstallFolder_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator x:Name="UnclipSeparator" Tag="UnclipSeparator" Background="{DynamicResource BorderDarkBrush}" />
            <MenuItem x:Name="UnclipPackageMenuItem" Tag="UnclipPackageMenuItem" Header="{loc:Loc Menu_UnclipFromPackage}" Click="UnclipPackage_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconUnclip}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>

            <!-- Neuer Trennungsstrich Ã¼ber "Paket lÃ¶schen" fÃ¼r Verifizierungs- und Entpackungs-Aktionen -->
            <Separator x:Name="VerificationSeparator" Tag="VerificationSeparator" Background="{DynamicResource BorderDarkBrush}" />
            <MenuItem x:Name="ExtractPackageMenuItem" Tag="ExtractPackageMenuItem"
                      Header="{loc:Loc Menu_ExtractPackage}" Click="ExtractPackage_MenuItem_Click">
                <MenuItem.Icon>
                    <Path x:Name="ExtractPackageIconPath" Data="{StaticResource IconArchive}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="PauseResumeExtractionMenuItem" Tag="PauseResumeExtractionMenuItem"
                      Header="{loc:Loc Menu_PauseExtraction}" Click="PauseResumeExtraction_MenuItem_Click">
                <MenuItem.Icon>
                    <Path x:Name="PauseResumeExtractionIconPath" Data="{StaticResource IconPause}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="CancelExtractionMenuItem" Tag="CancelExtractionMenuItem"
                      Header="{loc:Loc Menu_CancelExtraction}" Click="CancelExtraction_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconClose}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="VerifyBinFilesMenuItem" Tag="VerifyBinFilesMenuItem"
                      Header="{loc:Loc Menu_VerifyBinFiles}" Click="VerifyBinFiles_MenuItem_Click"
                      Visibility="{Binding HasVerifyBatFile, Converter={StaticResource BoolToVisConverter}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="Par2RepairMenuItem" Tag="Par2RepairMenuItem"
                      Header="{loc:Loc Menu_Par2Repair}" Click="Par2Repair_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconShield}" Fill="{DynamicResource AccentBlueBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator Background="{DynamicResource BorderDarkBrush}" />
            <MenuItem Header="{loc:Loc Menu_DeletePackage}" Click="DeletePackage_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconTrash}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="ItemContextMenu" Opened="ItemContextMenu_Opened">
            <MenuItem Header="{Binding Converter={StaticResource ItemActionMenuHeaderConverter}}"
                      Click="RetryItem_MenuItem_Click"
                      Command="{Binding DataContext.RetryItemCommand, Source={x:Reference RootWindow}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding Status, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='!Completed'}">
                <MenuItem.Icon>
                    <Path Data="{Binding Converter={StaticResource ItemActionMenuGeometryConverter}}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="{DynamicResource BorderDarkBrush}" Visibility="{Binding Status, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='!Completed'}" />
            <MenuItem Header="{loc:Loc Menu_Rename}" Click="RenameItem_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconFile}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="ExtractArchiveItemMenuItem" Tag="ExtractArchiveItemMenuItem"
                      Header="{loc:Loc Menu_ExtractArchive}" Click="ExtractItem_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconArchive}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu_ShowInExplorer}" Click="ShowItemInExplorer_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu_CopyOriginalUrl}" Click="CopyItemUrl_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="{DynamicResource BorderDarkBrush}" />
            <MenuItem Header="{loc:Loc Menu_DeleteItem}" Click="DeleteItem_MenuItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconTrash}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Toolbar Square Button Style (Tabs-like flat rectangular button with separator line on the right) -->
        <Style x:Key="ToolbarSquareButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="0,0,1,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Dropdown Menu Item Style -->
        <Style x:Key="FilterDropdownItemStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BgInputBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ================= SHARED DOWNLOAD ITEM TEMPLATE ================= -->
        <DataTemplate x:Key="DownloadItemTemplate" DataType="{x:Type models:DownloadItem}">
            <Border Margin="0,1"
                    Padding="0,3"
                    CornerRadius="4"
                    Focusable="True"
                    FocusVisualStyle="{x:Null}"
                    MouseLeftButtonDown="ItemRow_MouseLeftButtonDown"
                    PreviewMouseRightButtonDown="ItemRow_PreviewMouseRightButtonDown"
                    ContextMenu="{StaticResource ItemContextMenu}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot0, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot0, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot1, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot1, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot2, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot2, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot3, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot3, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot4, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot4, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot5, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot5, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot6, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot6, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot7, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot7, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot8, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot8, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot9, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot9, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot10, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot10, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot11, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot11, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>

                    <!-- 0: Centered Check/Cross Toggle + Modern Tree Connector Branch + Authentic Windows File/Zip Icon + Inline Editable File Name -->
                    <Border Grid.Column="{Binding DataContext.ColIndexName, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerName, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="6,0"
                            Visibility="{Binding DataContext.ShowColName, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                            <Setter Property="Margin" Value="28,0,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Subtle Discreet Cross/Check Toggle -->
                            <ToggleButton IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                          Width="18" Height="18"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Cursor="Hand"
                                          Style="{x:Null}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ToolTip="{loc:Loc Menu_ToggleItem_ToolTip}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Border x:Name="Box" Width="13" Height="13" CornerRadius="3.5" 
                                                    Background="{DynamicResource BgInputBrush}" 
                                                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path x:Name="CheckGlyph" Data="{StaticResource IconCheck}" Fill="#10B981" Width="7.5" Height="7.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="1.0" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <ScaleTransform x:Name="CheckGlyphScale" ScaleX="1.0" ScaleY="1.0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <Path x:Name="CrossGlyph" Data="{StaticResource IconClose}" Fill="#EF4444" Width="6.5" Height="6.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.0" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <ScaleTransform x:Name="CrossGlyphScale" ScaleX="1.0" ScaleY="1.0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18" />
                                                            <DoubleAnimation Storyboard.TargetName="CrossGlyph" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.25" />
                                                            <DoubleAnimation Storyboard.TargetName="CrossGlyphScale" Storyboard.TargetProperty="ScaleX" From="0.35" To="1.0" Duration="0:0:0.32">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="CrossGlyphScale" Storyboard.TargetProperty="ScaleY" From="0.35" To="1.0" Duration="0:0:0.32">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CrossGlyph" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18" />
                                                            <DoubleAnimation Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.25" />
                                                            <DoubleAnimation Storyboard.TargetName="CheckGlyphScale" Storyboard.TargetProperty="ScaleX" From="0.35" To="1.0" Duration="0:0:0.34">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="CheckGlyphScale" Storyboard.TargetProperty="ScaleY" From="0.35" To="1.0" Duration="0:0:0.34">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Tree Connecting Line -->
                            <Path Data="M 2,-14 L 2,6 Q 2,14 10,14 L 18,14" 
                                  Stroke="{DynamicResource TextSecondaryBrush}" 
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Opacity="0.55"
                                  Width="18" Height="28" 
                                  Margin="0,-6,6,-4" 
                                  VerticalAlignment="Center" />

                            <!-- Windows System Shell Icon for this File (.zip, .rar, .7z, .mp4, etc.) -->
                            <Image Source="{Binding FileName, Converter={StaticResource FileIconConverter}}" 
                                   Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" 
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <!-- Normal Text -->
                            <TextBlock Text="{Binding FileName}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       TextTrimming="CharacterEllipsis" 
                                       VerticalAlignment="Center" 
                                       Cursor="Hand" 
                                       ToolTip="{loc:Loc Menu_DoubleClickRename_ToolTip}"
                                       MouseLeftButtonDown="ItemName_MouseDoubleClick">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Inline Edit TextBox -->
                            <TextBox Text="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                     FontSize="11" 
                                     Background="{DynamicResource BgInputBrush}" 
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource AccentBlueBrush}"
                                     Padding="3,1"
                                     KeyDown="ItemRenameTextBox_KeyDown"
                                     LostFocus="ItemRenameTextBox_LostFocus"
                                     IsVisibleChanged="RenameTextBox_IsVisibleChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <!-- 1: Hoster Column (OFFICIAL HIGH-RES HOSTER FAVICON / BRAND LOGO) -->
                    <Border Grid.Column="{Binding DataContext.ColIndexHoster, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerHoster, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="2,0" ToolTip="{Binding HosterName}"
                            Visibility="{Binding DataContext.ShowColHoster, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <Image Source="{Binding HosterName, Converter={StaticResource HosterImageConverter}}" 
                               Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- 2: Save path -->
                    <Border Grid.Column="{Binding DataContext.ColIndexSavePath, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerSavePath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="6,0"
                            Visibility="{Binding DataContext.ShowColSavePath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding SaveFilePath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SaveFilePath}" />
                    </Border>

                    <!-- 3: File Size -->
                    <Border Grid.Column="{Binding DataContext.ColIndexSize, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0,8,0"
                            Visibility="{Binding DataContext.ShowColSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesConverter}}" 
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- 4: Individual Progress Percentage -->
                    <Border Grid.Column="{Binding DataContext.ColIndexProgress, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerProgress, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0,8,0"
                            Visibility="{Binding DataContext.ShowColProgress, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0.00} %'}" 
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- 5: Speed -->
                    <Border Grid.Column="{Binding DataContext.ColIndexSpeed, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerSpeed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0,8,0"
                            Visibility="{Binding DataContext.ShowColSpeed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding SpeedBytesPerSecond, Converter={StaticResource SpeedConverter}}" 
                                   FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- 6: ETA -->
                    <Border Grid.Column="{Binding DataContext.ColIndexEta, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerEta, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0"
                            Visibility="{Binding DataContext.ShowColEta, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding RemainingSeconds, Converter={StaticResource EtaConverter}}" 
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- 7: Status Badge -->
                    <Border Grid.Column="{Binding DataContext.ColIndexStatus, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerStatus, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="6,0"
                            Visibility="{Binding DataContext.ShowColStatus, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding Status, Converter={StaticResource StatusBrushConverter}}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 8: Added Date -->
                    <Border Grid.Column="{Binding DataContext.ColIndexAddedDate, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerAddedDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0"
                            Visibility="{Binding DataContext.ShowColAddedDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- 9: Completed Date -->
                    <Border Grid.Column="{Binding DataContext.ColIndexCompletedDate, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerCompletedDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0"
                            Visibility="{Binding DataContext.ShowColCompletedDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding CompletedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}', TargetNullValue='--'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- 10: Checksum -->
                    <Border Grid.Column="{Binding DataContext.ColIndexChecksum, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerChecksum, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="6,0"
                            Visibility="{Binding DataContext.ShowColChecksum, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding DisplayChecksum, TargetNullValue='---'}" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayChecksum}" />
                    </Border>

                    <!-- 11: Item Actions (Pause/Resume + Copy Link, left-aligned) -->
                    <Border Grid.Column="{Binding DataContext.ColIndexActions, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="{Binding DataContext.ShowDividerActions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="8,0"
                            Visibility="{Binding DataContext.ShowColActions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <!-- Pause / Resume Item -->
                            <Button Command="{Binding DataContext.ToggleItemPauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Status, Converter={StaticResource PlayPauseTooltipConverter}}"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Visibility="{Binding Status, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='!Completed'}"
                                    Margin="0,0,4,0">
                                <Path Data="{Binding Status, Converter={StaticResource PlayPauseGeometryConverter}}" Fill="{DynamicResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <!-- Copy Link -->
                            <Button Command="{Binding DataContext.CopyItemUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{loc:Loc Menu_CopyUrl_ToolTip}"
                                    Style="{StaticResource RowActionButtonStyle}">
                                <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- ================= SHARED DOWNLOAD PACKAGE TEMPLATE (ROOT & CLIPPED) ================= -->
        <DataTemplate x:Key="PackageTemplate" DataType="{x:Type models:DownloadPackage}">
            <DataTemplate.Resources>
                <!-- Modern clean shine animation (luminous silver-white) on package completion -->
                <Storyboard x:Key="PackageShineStoryboard">
                    <DoubleAnimation Storyboard.TargetName="PackageShineOverlay"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetName="PackageShineOverlay"
                                     Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                                     From="-1.2" To="1.2" Duration="0:0:2.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PackageShineOverlay"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1.0" To="0.0" BeginTime="0:0:1.8" Duration="0:0:0.6" />
                </Storyboard>

                <!-- Docking Slide & Glow Storyboard for Clipped Package: Smooth slide-in to native dock position -->
                <Storyboard x:Key="PackageSnapStoryboard">
                    <DoubleAnimation Storyboard.TargetName="PackageDockTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="6" To="0" Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PackageBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PackageDockOverlay"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.4" To="0.0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </DataTemplate.Resources>

            <StackPanel Margin="0">
                <!-- ================= PACKAGE ROW ================= -->
                <Border x:Name="PackageBorder"
                        Margin="0,0.5"
                        Padding="0,1.5"
                        CornerRadius="4"
                        Focusable="True"
                        FocusVisualStyle="{x:Null}"
                        AllowDrop="True"
                        PreviewMouseLeftButtonDown="PackageRow_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PackageRow_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="PackageRow_PreviewMouseLeftButtonUp"
                        MouseLeftButtonDown="PackageRow_MouseLeftButtonDown"
                        PreviewMouseRightButtonDown="PackageRow_PreviewMouseRightButtonDown"
                        DragOver="PackageRow_DragOver"
                        DragLeave="PackageRow_DragLeave"
                        Drop="PackageRow_Drop"
                        ContextMenu="{StaticResource PackageContextMenu}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PackageDockTransform" X="0" Y="0" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                    <Setter Property="Background" Value="#2A3B82F6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot0, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot0, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot1, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot1, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot2, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot2, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot3, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot3, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot4, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot4, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot5, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot5, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot6, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot6, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot7, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot7, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot8, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot8, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot9, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot9, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot10, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot10, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="{Binding DataContext.GridColWidthSlot11, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="{Binding DataContext.ActualColWidthSlot11, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="*" MinWidth="0" />
                        </Grid.ColumnDefinitions>

                        <!-- 0: Tree connector branch (when clipped) + Toggle Expander + Authentic Windows Zip Icon + Inline Editable Name -->
                        <Border Grid.Column="{Binding DataContext.ColIndexName, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerName, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="6,0"
                                Visibility="{Binding DataContext.ShowColName, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClipped}" Value="True">
                                                <Setter Property="Margin" Value="6,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Tree connector branch: vertical down and curving right (Only visible for clipped sub-packages) -->
                                <Path Data="M 4,-14 L 4,6 Q 4,14 12,14 L 18,14" 
                                      Stroke="{DynamicResource TextSecondaryBrush}" 
                                      StrokeThickness="1.5" 
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Opacity="0.55"
                                      Width="18" Height="28" 
                                      Margin="0,-6,4,-4" 
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsClipped, Converter={StaticResource BoolToVisConverter}}" />

                                <!-- Expander Toggle Button with smooth rotation animation -->
                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" 
                                              Cursor="Hand"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Width" Value="18" />
                                            <Setter Property="Height" Value="18" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsClipped}" Value="True">
                                                    <Setter Property="Width" Value="16" />
                                                    <Setter Property="Height" Value="16" />
                                                    <Setter Property="Margin" Value="0,0,5,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <!-- Subtle Rounded Hover Background -->
                                                <Border x:Name="HoverOverlay" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="4" 
                                                        Background="{DynamicResource BgCardAltBrush}" 
                                                        BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                        BorderThickness="1" 
                                                        Opacity="0" />
                                                <Path x:Name="Arrow" 
                                                      Data="{StaticResource IconChevronRight}" 
                                                      Fill="{DynamicResource TextSecondaryBrush}" 
                                                      Width="9" Height="9" 
                                                      Stretch="Uniform" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="ArrowScale" ScaleX="1.0" ScaleY="1.0" />
                                                            <RotateTransform x:Name="ArrowRotate" Angle="0" />
                                                        </TransformGroup>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                                                 Storyboard.TargetProperty="Angle"
                                                                                 To="90" Duration="0:0:0.35">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="ArrowScale"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 From="0.85" To="1.0" Duration="0:0:0.35">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="ArrowScale"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 From="0.85" To="1.0" Duration="0:0:0.35">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                                                 Storyboard.TargetProperty="Angle"
                                                                                 To="0" Duration="0:0:0.32">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="ArrowScale"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 From="0.85" To="1.0" Duration="0:0:0.32">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="ArrowScale"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 From="0.85" To="1.0" Duration="0:0:0.32">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- Authentic Native Windows ZIP Icon -->
                                <Image Source="{Binding Name, Converter={StaticResource PackageIconConverter}}" 
                                       VerticalAlignment="Center" 
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Width" Value="18" />
                                            <Setter Property="Height" Value="18" />
                                            <Setter Property="Margin" Value="0,0,8,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsClipped}" Value="True">
                                                    <Setter Property="Width" Value="17" />
                                                    <Setter Property="Height" Value="17" />
                                                    <Setter Property="Margin" Value="0,0,6,0" />
                                                    <Setter Property="ToolTip" Value="{Binding ParentPackageName, StringFormat='Angeheftet an: {0}'}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Name & Edit TextBox + Subtitle -->
                                <StackPanel VerticalAlignment="Center" Margin="0,0,4,0">
                                    <!-- Normal View -->
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               TextTrimming="CharacterEllipsis" 
                                               Cursor="Hand" 
                                               ToolTip="{loc:Loc Menu_DoubleClickRename_ToolTip}"
                                               MouseLeftButtonDown="PackageName_MouseDoubleClick">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsClipped}" Value="True">
                                                        <Setter Property="FontSize" Value="11.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Inline Edit TextBox -->
                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                             FontWeight="Bold"
                                             Background="{DynamicResource BgInputBrush}" 
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource AccentBlueBrush}"
                                             Padding="4,2"
                                             KeyDown="PackageRenameTextBox_KeyDown"
                                             LostFocus="PackageRenameTextBox_LostFocus"
                                             IsVisibleChanged="RenameTextBox_IsVisibleChanged">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsClipped}" Value="True">
                                                        <Setter Property="FontSize" Value="11.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding ItemsCountSummary, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="10" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsClipped}" Value="True">
                                                            <Setter Property="FontSize" Value="9.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Animated next task steps -->
                                        <ItemsControl ItemsSource="{Binding NextTaskSteps}"
                                                      ToolTip="{Binding NextTaskTooltip}"
                                                      Visibility="{Binding HasNextTasks, Converter={StaticResource BoolToVisConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:NextTaskStep}">
                                                    <TextBlock x:Name="StepText" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="10" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsClipped, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                        <Setter Property="FontSize" Value="9.5" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="#9CA3AF" />
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                                            <Setter TargetName="StepText" Property="Foreground" Value="#34D399" />
                                                            <Setter TargetName="StepText" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Transitioning">
                                                            <Setter TargetName="StepText" Property="Foreground" Value="#34D399" />
                                                            <Setter TargetName="StepText" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                                            <Setter TargetName="StepText" Property="Foreground" Value="#10B981" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 1: Hoster Column (Empty for Package/Folder) -->
                        <Border Grid.Column="{Binding DataContext.ColIndexHoster, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerHoster, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="2,0"
                                Visibility="{Binding DataContext.ShowColHoster, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />

                        <!-- 2: Save path -->
                        <Border Grid.Column="{Binding DataContext.ColIndexSavePath, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerSavePath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="6,0"
                                Visibility="{Binding DataContext.ShowColSavePath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding SaveDirectory}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SaveDirectory}" />
                        </Border>

                        <!-- 3: Total Size -->
                        <Border Grid.Column="{Binding DataContext.ColIndexSize, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0,8,0"
                                Visibility="{Binding DataContext.ShowColSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesConverter}}" 
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- 4: Aggregated Progress Percentage -->
                        <Border Grid.Column="{Binding DataContext.ColIndexProgress, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerProgress, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0,8,0"
                                Visibility="{Binding DataContext.ShowColProgress, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Base Text -->
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0.00} %'}" 
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <!-- Neon Shimmer Layer (glides over % digits when active) -->
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0.00} %'}" 
                                           FontWeight="SemiBold" FontSize="11" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Foreground">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <LinearGradientBrush.RelativeTransform>
                                                            <TranslateTransform X="-1.8" />
                                                        </LinearGradientBrush.RelativeTransform>
                                                        <GradientStop Color="Transparent" Offset="0.0" />
                                                        <GradientStop Color="#4538BDF8" Offset="0.25" />
                                                        <GradientStop Color="#EFFFFFFF" Offset="0.5" />
                                                        <GradientStop Color="#4538BDF8" Offset="0.75" />
                                                        <GradientStop Color="Transparent" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PackagePercentShimmerStoryboard">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                                                                                 From="-1.8" To="1.8" Duration="0:0:1.8" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PackagePercentShimmerStoryboard" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- 5: Aggregated Speed -->
                        <Border Grid.Column="{Binding DataContext.ColIndexSpeed, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerSpeed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0,8,0"
                                Visibility="{Binding DataContext.ShowColSpeed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding SpeedBytesPerSecond, Converter={StaticResource SpeedConverter}}" 
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- 6: Aggregated ETA -->
                        <Border Grid.Column="{Binding DataContext.ColIndexEta, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerEta, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0"
                                Visibility="{Binding DataContext.ShowColEta, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding RemainingSeconds, Converter={StaticResource EtaConverter}}" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- 7: Package Status Badge -->
                        <Border Grid.Column="{Binding DataContext.ColIndexStatus, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerStatus, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="6,0"
                                Visibility="{Binding DataContext.ShowColStatus, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding Status, Converter={StaticResource StatusBrushConverter}}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 8: Added Date -->
                        <Border Grid.Column="{Binding DataContext.ColIndexAddedDate, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerAddedDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0"
                                Visibility="{Binding DataContext.ShowColAddedDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- 9: Completed Date -->
                        <Border Grid.Column="{Binding DataContext.ColIndexCompletedDate, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerCompletedDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="4,0"
                                Visibility="{Binding DataContext.ShowColCompletedDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding CompletedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}', TargetNullValue='--'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- 10: Checksum -->
                        <Border Grid.Column="{Binding DataContext.ColIndexChecksum, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerChecksum, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="6,0"
                                Visibility="{Binding DataContext.ShowColChecksum, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="---" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- 11: Package Action Buttons (Pause/Resume + Copy URLs, left-aligned) -->
                        <Border Grid.Column="{Binding DataContext.ColIndexActions, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="{Binding DataContext.ShowDividerActions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToRightBorderThicknessConverter}}" Padding="8,0"
                                Visibility="{Binding DataContext.ShowColActions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <!-- Pause / Resume Package -->
                                <Button Command="{Binding DataContext.TogglePackagePauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Status, Converter={StaticResource PlayPauseTooltipConverter}}"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        Visibility="{Binding Status, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='!Completed'}"
                                        Margin="0,0,4,0">
                                    <Path Data="{Binding Status, Converter={StaticResource PlayPauseGeometryConverter}}" Fill="{DynamicResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <!-- Copy Package URLs -->
                                <Button Command="{Binding DataContext.CopyPackageUrlsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{loc:Loc Menu_CopyAllUrls}"
                                        Style="{StaticResource RowActionButtonStyle}">
                                    <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Modern Clean Shine Animation Overlay (App Gray / Luminous Silver-White) -->
                        <Border x:Name="PackageShineOverlay"
                                Grid.Column="0" Grid.ColumnSpan="13"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.03">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="PackageShineTransform" X="-1.2" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="Transparent" Offset="0.0" />
                                    <GradientStop Color="#00E2E8F0" Offset="0.32" />
                                    <GradientStop Color="#45CBD5E1" Offset="0.44" />
                                    <GradientStop Color="#85FFFFFF" Offset="0.50" />
                                    <GradientStop Color="#45CBD5E1" Offset="0.56" />
                                    <GradientStop Color="#00E2E8F0" Offset="0.68" />
                                    <GradientStop Color="Transparent" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Subtle Soft Dock Highlight Overlay (Only active during snap animation) -->
                        <Border x:Name="PackageDockOverlay"
                                Grid.Column="0" Grid.ColumnSpan="13"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Background="#1038BDF8"
                                BorderBrush="#3038BDF8"
                                BorderThickness="1" />
                    </Grid>
                </Border>

                <!-- ================= CHILD ITEMS LIST (FILES / LINKS) ================= -->
                <helpers:AnimatedExpansionDecorator IsExpanded="{Binding IsExpanded}">
                    <ItemsControl ItemsSource="{Binding Items}"
                                  ItemTemplate="{StaticResource DownloadItemTemplate}"
                                  Tag="{Binding IsClipped}" />
                </helpers:AnimatedExpansionDecorator>

                <!-- ================= CLIPPED SUB-PACKAGES (DOCKED DIRECTLY UNDERNEATH) ================= -->
                <ItemsControl ItemsSource="{Binding ClippedPackages}"
                              ItemTemplate="{DynamicResource PackageTemplate}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClipped}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNewlyCompleted}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource PackageShineStoryboard}" />
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsJustSnapped}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource PackageSnapStoryboard}" />
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Browser Tab Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Container -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= TOP BROWSER-STYLE TAB BAR ================= -->
        <Border Grid.Row="0" 
                Background="{DynamicResource BgDarkBrush}" 
                BorderBrush="{DynamicResource BorderDarkBrush}" 
                BorderThickness="0,0,0,1" 
                Height="38" 
                Padding="0" 
                Panel.ZIndex="10"
                SnapsToDevicePixels="True" 
                UseLayoutRounding="True">
            <DockPanel LastChildFill="False">
                <!-- Browser Tabs Strip (Docked to far left) with Sliding Indicator & Upward Glow -->
                <Grid x:Name="TabStripContainer" 
                      DockPanel.Dock="Left" 
                      VerticalAlignment="Stretch"
                      ClipToBounds="False">
                    <!-- Tab Buttons -->
                    <StackPanel x:Name="TabButtonsPanel" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Stretch" 
                                Margin="0">
                        <!-- Tab 1: Downloads -->
                        <Button x:Name="DownloadsTabButton"
                                Command="{Binding SwitchToDownloadsTabCommand}"
                                Height="38"
                                MinWidth="136"
                                VerticalAlignment="Stretch"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <!-- Main Tab Body & Right Border -->
                                        <Border x:Name="TabBg"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="0,0,1,0"
                                                Padding="20,0">
                                            <StackPanel Orientation="Horizontal" 
                                                        VerticalAlignment="Center" 
                                                        HorizontalAlignment="Center">
                                                <Path x:Name="TabIcon" 
                                                      Data="{StaticResource IconDownload}" 
                                                      Width="13" Height="13" 
                                                      Stretch="Uniform" 
                                                      VerticalAlignment="Center" 
                                                      Margin="0,0,9,0" 
                                                      Fill="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TabText" 
                                                           Text="{loc:Loc Tab_Downloads}" 
                                                           FontSize="12.5" 
                                                           FontWeight="Normal" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <!-- Inactive Tab Hover -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource BgCardBrush}" />
                                            <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter TargetName="TabIcon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>

                                        <!-- Active State (Downloads selected) -->
                                        <DataTrigger Binding="{Binding SelectedMainTab}" Value="Downloads">
                                            <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource BgHeaderBrush}" />
                                            <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="TabIcon" Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Tab 2: Settings -->
                        <Button x:Name="SettingsTabButton"
                                Command="{Binding SwitchToSettingsTabCommand}"
                                Height="38"
                                MinWidth="136"
                                VerticalAlignment="Stretch"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <!-- Main Tab Body & Right Border -->
                                        <Border x:Name="TabBg"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="0,0,1,0"
                                                Padding="20,0">
                                            <StackPanel Orientation="Horizontal" 
                                                        VerticalAlignment="Center" 
                                                        HorizontalAlignment="Center">
                                                <Path x:Name="TabIcon" 
                                                      Data="{StaticResource IconSettings}" 
                                                      Width="13" Height="13" 
                                                      Stretch="Uniform" 
                                                      VerticalAlignment="Center" 
                                                      Margin="0,0,9,0" 
                                                      Fill="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TabText" 
                                                           Text="{loc:Loc Tab_Settings}" 
                                                           FontSize="12.5" 
                                                           FontWeight="Normal" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <!-- Inactive Tab Hover -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource BgCardBrush}" />
                                            <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter TargetName="TabIcon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>

                                        <!-- Active State (Settings selected) -->
                                        <DataTrigger Binding="{Binding SelectedMainTab}" Value="Settings">
                                            <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource BgHeaderBrush}" />
                                            <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="TabIcon" Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Animated Sliding Tab Indicator -->
                    <Grid x:Name="SlidingTabIndicator"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          IsHitTestVisible="False"
                          ClipToBounds="False"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True"
                          Width="136">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="TabIndicatorTransform" X="0" Y="0" />
                        </Grid.RenderTransform>

                        <!-- Sleek Modern Accent Underline -->
                        <Border Height="1" 
                                VerticalAlignment="Bottom" 
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                Background="{DynamicResource AccentBlueBrush}" />
                    </Grid>
                </Grid>

                <!-- Subtle Countdown Indicator in Tab Bar when on Settings tab (dezent, oben rechts) -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPostDownloadCountdownActive}" Value="True" />
                                        <Condition Binding="{Binding SelectedMainTab}" Value="Settings" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding PostDownloadCountdownText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Command="{Binding CancelPostDownloadCountdownCommand}"
                            Cursor="Hand"
                            Margin="10,0,0,0"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            ToolTip="{loc:Loc PostDownload_Btn_Cancel}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="BtnText" 
                                               Text="{loc:Loc PostDownload_Btn_Cancel}" 
                                               FontSize="11.5" 
                                               Foreground="#EF4444" 
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnText" Property="TextDecorations" Value="Underline" />
                                        <Setter TargetName="BtnText" Property="Foreground" Value="#F87171" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= MAIN CONTENT CONTAINER ================= -->
        <Grid Grid.Row="1">
            <!-- TAB 1: DOWNLOADS -->
            <Grid x:Name="DownloadsTabContent" 
                  IsVisibleChanged="TabContent_IsVisibleChanged"
                  Visibility="{Binding SelectedMainTab, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Downloads'}"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <!-- Top Actions Toolbar -->
                    <RowDefinition Height="Auto" />
                    <!-- Main Content (TreeListView) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ================= TOP ACTIONS TOOLBAR ================= -->
                <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Height="34" Padding="0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <DockPanel LastChildFill="False">
                        <!-- Left: Download Queue Action Buttons & Busy Progress Indicator -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <!-- Download Queue Action Buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                <!-- Start All Downloads Button -->
                                <Button Command="{Binding StartAllCommand}" Style="{DynamicResource ToolbarSquareButtonStyle}" ToolTip="{loc:Loc Toolbar_StartAll_ToolTip}">
                                    <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource AccentBlueBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>

                                <!-- Pause All Downloads Button -->
                                <Button Command="{Binding PauseAllCommand}" Style="{DynamicResource ToolbarSquareButtonStyle}" ToolTip="{loc:Loc Toolbar_PauseAll_ToolTip}">
                                    <Path Data="{StaticResource IconPause}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>

                                <!-- Delete Selected Button -->
                                <Button Command="{Binding DeleteSelectedCommand}" Style="{DynamicResource ToolbarSquareButtonStyle}" ToolTip="{loc:Loc Toolbar_DeleteSelected_ToolTip}">
                                    <Path Data="{StaticResource IconTrash}" Fill="#EF4444" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>

                                <!-- Expand All (Arrow Down) -->
                                <Button Command="{Binding ExpandAllCommand}" Style="{DynamicResource ToolbarSquareButtonStyle}" ToolTip="{loc:Loc Toolbar_ExpandAll_ToolTip}">
                                    <Path Data="{StaticResource IconChevronDown}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>

                                <!-- Collapse All (Arrow Up) -->
                                <Button Command="{Binding CollapseAllCommand}" Style="{DynamicResource ToolbarSquareButtonStyle}" ToolTip="{loc:Loc Toolbar_CollapseAll_ToolTip}">
                                    <Path Data="{StaticResource IconChevronUp}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>

                                <!-- Clear Completed Button (Icon-Only) -->
                                <Button Command="{Binding ClearCompletedCommand}" Style="{DynamicResource ToolbarSquareButtonStyle}" ToolTip="{loc:Loc Toolbar_ClearCompleted_ToolTip}">
                                    <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>

                                <!-- Update Notification Button (Clean square button matching toolbar; no pulsing/animation) -->
                                <Button Command="{Binding OpenUpdateDialogCommand}"
                                        Style="{DynamicResource ToolbarSquareButtonStyle}"
                                        ToolTip="{Binding UpdateTooltip}"
                                        ToolTipService.ShowOnDisabled="True">
                                    <Path Data="{StaticResource IconUpdate}"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>

                                <!-- Clipboard Link Grabber Quick-Toggle Button (beside Update button) -->
                                <Button Command="{Binding ToggleClipboardMonitorCommand}"
                                        Style="{DynamicResource ToolbarSquareButtonStyle}"
                                        ToolTip="{Binding ClipboardMonitorTooltip}">
                                    <Path Data="{StaticResource IconClipboardLink}"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EnableClipboardMonitor}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>

                                <!-- Post-Download Action Quick-Button (Auto-Shutdown / Sleep / Exit App) -->
                                <Button x:Name="PostDownloadActionButton"
                                        Click="PostDownloadActionButton_Click"
                                        Style="{DynamicResource ToolbarSquareButtonStyle}"
                                        ToolTip="{Binding PostDownloadActionTooltip}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc PostDownload_Action_None}"
                                                      IsCheckable="True"
                                                      IsChecked="{Binding IsNoneActionSelected}"
                                                      Command="{Binding SetPostDownloadActionCommand}"
                                                      CommandParameter="None" />
                                            <MenuItem Header="{loc:Loc PostDownload_Action_Shutdown}"
                                                      IsCheckable="True"
                                                      IsChecked="{Binding IsShutdownActionSelected}"
                                                      Command="{Binding SetPostDownloadActionCommand}"
                                                      CommandParameter="Shutdown" />
                                            <MenuItem Header="{loc:Loc PostDownload_Action_Sleep}"
                                                      IsCheckable="True"
                                                      IsChecked="{Binding IsSleepActionSelected}"
                                                      Command="{Binding SetPostDownloadActionCommand}"
                                                      CommandParameter="Sleep" />
                                            <MenuItem Header="{loc:Loc PostDownload_Action_ExitApp}"
                                                      IsCheckable="True"
                                                      IsChecked="{Binding IsExitAppActionSelected}"
                                                      Command="{Binding SetPostDownloadActionCommand}"
                                                      CommandParameter="ExitApp" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Path Data="{StaticResource IconPower}"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPostDownloadActionActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </StackPanel>

                            <!-- Busy / Link Extraction Spinner & Message -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Canvas Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Canvas.RenderTransform>
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Style.Triggers>
                                                    <Trigger Property="Visibility" Value="Visible">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard Name="ToolbarSpinStoryboard">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0" To="360"
                                                                                     Duration="0:0:0.9"
                                                                                     RepeatBehavior="Forever" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="ToolbarSpinStoryboard" />
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>

                                        <Ellipse Canvas.Left="15.75" Canvas.Top="8.75" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="1.00" />
                                        <Ellipse Canvas.Left="14.8" Canvas.Top="12.25" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.92" />
                                        <Ellipse Canvas.Left="12.25" Canvas.Top="14.8" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.83" />
                                        <Ellipse Canvas.Left="8.75" Canvas.Top="15.75" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.75" />
                                        <Ellipse Canvas.Left="5.25" Canvas.Top="14.8" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.67" />
                                        <Ellipse Canvas.Left="2.7" Canvas.Top="12.25" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.58" />
                                        <Ellipse Canvas.Left="1.75" Canvas.Top="8.75" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.50" />
                                        <Ellipse Canvas.Left="2.7" Canvas.Top="5.25" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.42" />
                                        <Ellipse Canvas.Left="5.25" Canvas.Top="2.7" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.33" />
                                        <Ellipse Canvas.Left="8.75" Canvas.Top="1.75" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.25" />
                                        <Ellipse Canvas.Left="12.25" Canvas.Top="2.7" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.17" />
                                        <Ellipse Canvas.Left="14.8" Canvas.Top="5.25" Width="2.5" Height="2.5" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.08" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding BusyMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Subtle Countdown Indicator ("dezent einfach text, ganz rechts von den aktion buttons") -->
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0"
                                    Visibility="{Binding IsPostDownloadCountdownActive, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding PostDownloadCountdownText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Command="{Binding CancelPostDownloadCountdownCommand}"
                                    Cursor="Hand"
                                    Margin="10,0,0,0"
                                    Padding="4,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc PostDownload_Btn_Cancel}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <TextBlock x:Name="BtnText" 
                                                       Text="{loc:Loc PostDownload_Btn_Cancel}" 
                                                       FontSize="11.5" 
                                                       Foreground="#EF4444" 
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnText" Property="TextDecorations" Value="Underline" />
                                                <Setter TargetName="BtnText" Property="Foreground" Value="#F87171" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ================= MAIN CONTENT (TreeListView) ================= -->
                <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- TreeListView (Downloads list) -->
                <RowDefinition x:Name="TreeListRow" Height="*" MinHeight="160" />
            </Grid.RowDefinitions>

            <!-- ================= TREELISTVIEW ================= -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <!-- Header Row with Resizable Dividers -->
                    <RowDefinition Height="Auto" />
                    <!-- List Items -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers with 1:1 Screen-Coordinate Resizing & Gear Customization Menu on the Far Right -->
                <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="0,0" ClipToBounds="True" PreviewMouseWheel="TreeList_PreviewMouseWheel">
                    <Border.ContextMenu>
                        <ContextMenu x:Name="ColumnHeaderContextMenu">
                            <MenuItem Header="{loc:Loc Col_Name}" IsCheckable="True" IsChecked="{Binding ShowColName, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_Hoster}" IsCheckable="True" IsChecked="{Binding ShowColHoster, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_SavePath}" IsCheckable="True" IsChecked="{Binding ShowColSavePath, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_Size}" IsCheckable="True" IsChecked="{Binding ShowColSize, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_Progress}" IsCheckable="True" IsChecked="{Binding ShowColProgress, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_Speed}" IsCheckable="True" IsChecked="{Binding ShowColSpeed, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_Eta}" IsCheckable="True" IsChecked="{Binding ShowColEta, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_Status}" IsCheckable="True" IsChecked="{Binding ShowColStatus, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_AddedDate}" IsCheckable="True" IsChecked="{Binding ShowColAddedDate, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_CompletedDate}" IsCheckable="True" IsChecked="{Binding ShowColCompletedDate, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_Checksum}" IsCheckable="True" IsChecked="{Binding ShowColChecksum, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Header="{loc:Loc Col_Actions}" IsCheckable="True" IsChecked="{Binding ShowColActions, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <Separator Background="{DynamicResource BorderDarkBrush}" />
                            <MenuItem Header="{loc:Loc Col_ResetColumns}" Command="{Binding ResetColumnsCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource IconClose}" Fill="#EF4444" Width="11" Height="11" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <DockPanel LastChildFill="True">
                        <!-- Dedicated Far-Right Gear Button (always on the far right end of the table header, strictly above vertical scrollbar) -->
                        <Border DockPanel.Dock="Right" Width="18" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource BorderDarkBrush}" Background="{DynamicResource BgHeaderBrush}" Panel.ZIndex="1">
                            <Button x:Name="ColumnConfigButton" 
                                    Click="ColumnConfigButton_Click"
                                    Style="{x:Null}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    ToolTip="{loc:Loc Col_Customize_ToolTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="Transparent" Padding="2">
                                            <Path x:Name="BtnIcon" Data="{StaticResource IconSettings}" Fill="{DynamicResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                <Setter TargetName="BtnIcon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>

                        <!-- Column Headers Viewport (strictly clipped before the Gear button so columns never slide underneath) -->
                        <Border x:Name="HeaderViewportBorder" ClipToBounds="True">
                            <Grid>
                                <Grid x:Name="HeaderColumnsGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding GridColWidthSlot0}" MinWidth="{Binding ActualColWidthSlot0}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot1}" MinWidth="{Binding ActualColWidthSlot1}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot2}" MinWidth="{Binding ActualColWidthSlot2}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot3}" MinWidth="{Binding ActualColWidthSlot3}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot4}" MinWidth="{Binding ActualColWidthSlot4}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot5}" MinWidth="{Binding ActualColWidthSlot5}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot6}" MinWidth="{Binding ActualColWidthSlot6}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot7}" MinWidth="{Binding ActualColWidthSlot7}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot8}" MinWidth="{Binding ActualColWidthSlot8}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot9}" MinWidth="{Binding ActualColWidthSlot9}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot10}" MinWidth="{Binding ActualColWidthSlot10}" />
                                        <ColumnDefinition Width="{Binding GridColWidthSlot11}" MinWidth="{Binding ActualColWidthSlot11}" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Header 0: Package / File Name -->
                                    <Grid Grid.Column="{Binding ColIndexName}" Tag="Name" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColName, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,8,4">
                                            <TextBlock Text="{loc:Loc Col_Name}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="Name">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="Name">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="Name" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerName, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 1: Hoster -->
                                    <Grid Grid.Column="{Binding ColIndexHoster}" Tag="Hoster" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColHoster, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,4,2,4">
                                            <TextBlock Text="{loc:Loc Col_Hoster}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="Hoster">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="Hoster">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="Hoster" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerHoster, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 2: Save path -->
                                    <Grid Grid.Column="{Binding ColIndexSavePath}" Tag="SavePath" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColSavePath, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,8,4">
                                            <TextBlock Text="{loc:Loc Col_SavePath}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="SavePath">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="SavePath">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="SavePath" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerSavePath, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 3: Size -->
                                    <Grid Grid.Column="{Binding ColIndexSize}" Tag="Size" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColSize, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,4,8,4">
                                            <TextBlock Text="{loc:Loc Col_Size}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="Size">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="Size">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="Size" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerSize, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 4: Progress -->
                                    <Grid Grid.Column="{Binding ColIndexProgress}" Tag="Progress" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColProgress, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,4,8,4">
                                            <TextBlock Text="{loc:Loc Col_Progress}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="Progress">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="Progress">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="Progress" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerProgress, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 5: Speed -->
                                    <Grid Grid.Column="{Binding ColIndexSpeed}" Tag="Speed" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColSpeed, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,4,8,4">
                                            <TextBlock Text="{loc:Loc Col_Speed}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="Speed">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="Speed">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="Speed" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerSpeed, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 6: ETA -->
                                    <Grid Grid.Column="{Binding ColIndexEta}" Tag="Eta" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColEta, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,4,4,4">
                                            <TextBlock Text="{loc:Loc Col_Eta}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="Eta">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="Eta">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="Eta" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerEta, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 7: Status -->
                                    <Grid Grid.Column="{Binding ColIndexStatus}" Tag="Status" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColStatus, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,8,4">
                                            <TextBlock Text="{loc:Loc Col_Status}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="Status">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="Status">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="Status" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerStatus, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 8: Date Added -->
                                    <Grid Grid.Column="{Binding ColIndexAddedDate}" Tag="AddedDate" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColAddedDate, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,4,4,4">
                                            <TextBlock Text="{loc:Loc Col_AddedDate}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="AddedDate">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="AddedDate">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="AddedDate" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerAddedDate, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 9: Date Completed -->
                                    <Grid Grid.Column="{Binding ColIndexCompletedDate}" Tag="CompletedDate" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColCompletedDate, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,4,4,4">
                                            <TextBlock Text="{loc:Loc Col_CompletedDate}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="CompletedDate">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="CompletedDate">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="CompletedDate" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerCompletedDate, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 10: Checksum -->
                                    <Grid Grid.Column="{Binding ColIndexChecksum}" Tag="Checksum" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColChecksum, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,8,4">
                                            <TextBlock Text="{loc:Loc Col_Checksum}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="Checksum">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="Checksum">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="Checksum" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerChecksum, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Header 11: Aktionen -->
                                    <Grid Grid.Column="{Binding ColIndexActions}" Tag="Actions" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown" MouseMove="ColumnHeader_MouseMove" MouseLeftButtonUp="ColumnHeader_MouseLeftButtonUp" LostMouseCapture="ColumnHeader_LostMouseCapture"
                                          Visibility="{Binding ShowColActions, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,4,4">
                                            <TextBlock Text="{loc:Loc Col_Actions}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Path Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowGeometryConverter}" ConverterParameter="Actions">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Data>
                                                <Path.Visibility>
                                                    <MultiBinding Converter="{StaticResource ColumnSortArrowVisibilityConverter}" ConverterParameter="Actions">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDirection" />
                                                    </MultiBinding>
                                                </Path.Visibility>
                                            </Path>
                                        </StackPanel>
                                        <Border Tag="Actions" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent" 
                                                Visibility="{Binding ShowDividerActions, Converter={StaticResource BoolToVisConverter}}"
                                                MouseLeftButtonDown="HeaderDivider_MouseLeftButtonDown" MouseMove="HeaderDivider_MouseMove" MouseLeftButtonUp="HeaderDivider_MouseLeftButtonUp" LostMouseCapture="HeaderDivider_LostMouseCapture">
                                            <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- Dragged Column Header Bar (Full width and height bar sliding directly in header row) -->
                                <Canvas x:Name="ColumnDragCanvas" IsHitTestVisible="False" ClipToBounds="True">
                                    <Border x:Name="DraggedHeaderBar" 
                                            Height="34"
                                            Background="{DynamicResource BgCardAltBrush}" 
                                            BorderBrush="#553B82F6" 
                                            BorderThickness="1" 
                                            CornerRadius="0"
                                            Opacity="0.95" 
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True"
                                            Visibility="Collapsed">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.25" Direction="270" />
                                        </Border.Effect>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,4,4">
                                                <TextBlock x:Name="DraggedHeaderBarText" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Path x:Name="DraggedHeaderBarSortArrow" Width="7" Height="5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Canvas>

                                <!-- Drop Insertion Indicator -->
                                <Border x:Name="ColumnDropIndicator" 
                                        Width="2" 
                                        HorizontalAlignment="Left" 
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource AccentBlueBrush}" 
                                        CornerRadius="1"
                                        Visibility="Collapsed" 
                                        Panel.ZIndex="100"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#3B82F6" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Packages & Download Items List (TreeListView) -->
                <ScrollViewer Grid.Row="1" 
                              x:Name="TreeListScrollViewer"
                              CanContentScroll="True"
                              Background="{DynamicResource BgDarkBrush}"
                              VerticalScrollBarVisibility="Visible" 
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseDown="TreeListScrollViewer_PreviewMouseDown"
                              PreviewMouseWheel="TreeList_PreviewMouseWheel"
                              AllowDrop="True"
                              DragOver="PackagesScrollViewer_DragOver"
                              Drop="PackagesScrollViewer_Drop">
                    <ScrollViewer.Resources>
                        <Style x:Key="ScrollBarArrowButton" TargetType="{x:Type Button}">
                            <Setter Property="Width" Value="18" />
                            <Setter Property="Height" Value="18" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Path x:Name="ArrowIcon"
                                                  Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                  Width="8"
                                                  Height="8"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                <Setter TargetName="ArrowIcon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#111827" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.3" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <ScrollViewer.Template>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" 
                                                       Margin="{TemplateBinding Padding}" 
                                                       CanContentScroll="{TemplateBinding CanContentScroll}" />

                                <ScrollBar x:Name="PART_VerticalScrollBar" 
                                           Grid.Column="1" 
                                           Orientation="Vertical" 
                                           ViewportSize="{TemplateBinding ViewportHeight}" 
                                           Maximum="{TemplateBinding ScrollableHeight}" 
                                           Minimum="0" 
                                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                           Visibility="Visible" 
                                           Width="18"
                                           Background="Transparent">
                                    <ScrollBar.Template>
                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                            <Border x:Name="ScrollBarBorder" 
                                                    Background="Transparent" 
                                                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                    BorderThickness="1,0,0,0" 
                                                    Width="18">
                                                <Grid x:Name="ScrollBarContainer" Opacity="0.75">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="18" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="18" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Top Arrow Button -->
                                                    <Button Grid.Row="0"
                                                            Style="{StaticResource ScrollBarArrowButton}"
                                                            Content="{StaticResource IconChevronUp}"
                                                            ToolTip="Scroll to Top"
                                                            Click="ScrollToTop_Click"
                                                            Command="{x:Static ScrollBar.ScrollToTopCommand}" />

                                                    <!-- Center Track Area -->
                                                    <Grid Grid.Row="1">
                                                        <!-- Filled bar shown when list cannot be scrolled -->
                                                        <Border x:Name="DisabledFillBar" 
                                                                Background="{DynamicResource ScrollBarThumbBrush}" 
                                                                BorderBrush="{DynamicResource ScrollBarThumbBorderBrush}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="4" 
                                                                Margin="1,2" 
                                                                Visibility="Collapsed" />

                                                        <!-- Track for active scrolling -->
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True" HorizontalAlignment="Stretch" Width="18">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="{x:Static ScrollBar.PageUpCommand}" />
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb Focusable="False" IsTabStop="False" MinHeight="24" HorizontalAlignment="Stretch">
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                                            <Grid Margin="1,2">
                                                                                <!-- Base Thumb -->
                                                                                <Border x:Name="ThumbBorder" 
                                                                                        Background="{DynamicResource ScrollBarThumbBrush}" 
                                                                                        BorderBrush="{DynamicResource ScrollBarThumbBorderBrush}" 
                                                                                        BorderThickness="1" 
                                                                                        CornerRadius="4" 
                                                                                        HorizontalAlignment="Stretch" />
                                                                                <!-- Smooth Hover Overlay -->
                                                                                <Border x:Name="HoverOverlay" 
                                                                                        Background="{DynamicResource ScrollBarThumbHoverBrush}" 
                                                                                        BorderBrush="{DynamicResource ScrollBarThumbHoverBorderBrush}" 
                                                                                        BorderThickness="1" 
                                                                                        CornerRadius="4" 
                                                                                        HorizontalAlignment="Stretch"
                                                                                        Opacity="0" />
                                                                                <!-- Smooth Dragging Overlay -->
                                                                                <Border x:Name="DraggingOverlay" 
                                                                                        Background="{DynamicResource ScrollBarThumbDraggingBrush}" 
                                                                                        BorderBrush="{DynamicResource ScrollBarThumbDraggingBorderBrush}" 
                                                                                        BorderThickness="1" 
                                                                                        CornerRadius="4" 
                                                                                        HorizontalAlignment="Stretch"
                                                                                        Opacity="0" />
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                                                 To="1.0" Duration="0:0:0.12">
                                                                                                    <DoubleAnimation.EasingFunction>
                                                                                                        <CubicEase EasingMode="EaseOut" />
                                                                                                    </DoubleAnimation.EasingFunction>
                                                                                                </DoubleAnimation>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                    <Trigger.ExitActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                                                 To="0.0" Duration="0:0:0.16">
                                                                                                    <DoubleAnimation.EasingFunction>
                                                                                                        <CubicEase EasingMode="EaseOut" />
                                                                                                    </DoubleAnimation.EasingFunction>
                                                                                                </DoubleAnimation>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.ExitActions>
                                                                                </Trigger>
                                                                                <Trigger Property="IsDragging" Value="True">
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="DraggingOverlay"
                                                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                                                 To="1.0" Duration="0:0:0.08">
                                                                                                    <DoubleAnimation.EasingFunction>
                                                                                                        <CubicEase EasingMode="EaseOut" />
                                                                                                    </DoubleAnimation.EasingFunction>
                                                                                                </DoubleAnimation>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                    <Trigger.ExitActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="DraggingOverlay"
                                                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                                                 To="0.0" Duration="0:0:0.14">
                                                                                                    <DoubleAnimation.EasingFunction>
                                                                                                        <CubicEase EasingMode="EaseOut" />
                                                                                                    </DoubleAnimation.EasingFunction>
                                                                                                </DoubleAnimation>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.ExitActions>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="{x:Static ScrollBar.PageDownCommand}" />
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Grid>

                                                    <!-- Bottom Arrow Button -->
                                                    <Button Grid.Row="2"
                                                            Style="{StaticResource ScrollBarArrowButton}"
                                                            Content="{StaticResource IconChevronDown}"
                                                            ToolTip="Scroll to Bottom"
                                                            Click="ScrollToBottom_Click"
                                                            Command="{x:Static ScrollBar.ScrollToBottomCommand}" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ScrollBarContainer"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1.0" Duration="0:0:0.14">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ScrollBarContainer"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0.75" Duration="0:0:0.20">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="DisabledFillBar" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ScrollBar.Template>
                                </ScrollBar>
                            </Grid>
                        </ControlTemplate>
                    </ScrollViewer.Template>
                    <ItemsControl ItemsSource="{Binding RootPackages}"
                                  ItemTemplate="{StaticResource PackageTemplate}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLength="2,2"
                                  VirtualizingPanel.CacheLengthUnit="Page">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State Watermark Logo (perfectly centered, always centered) -->
                <Grid Grid.Row="1" 
                      IsHitTestVisible="False"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Visibility="{Binding IsDownloadsEmpty, Converter={StaticResource BoolToVisConverter}}">
                    <Image Source="pack://application:,,,/Reepax;component/Assets/R.png" 
                           Width="200" 
                           Height="200" 
                           Stretch="Uniform" 
                           Opacity="0.10" 
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>

    <!-- TAB 2: SETTINGS -->
    <views:SettingsView x:Name="SettingsTabContent" 
                        IsVisibleChanged="TabContent_IsVisibleChanged"
                        Visibility="{Binding SelectedMainTab, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Settings'}"
                        RenderTransformOrigin="0.5,0.5">
        <views:SettingsView.RenderTransform>
            <TranslateTransform X="0" Y="0" />
        </views:SettingsView.RenderTransform>
    </views:SettingsView>
</Grid>


        <!-- ================= BOTTOM ACTION & STATUS BAR ================= -->
        <Border Grid.Row="2" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel LastChildFill="True">
                <!-- Left Section: 'Add New Links' Button + Live Disk Space Box -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddLinksButton" Click="AddLinks_Click"
                            Height="28" Padding="14,0" Margin="0,0,8,0"
                            Background="{DynamicResource BgCardAltBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            Cursor="Hand"
                            SnapsToDevicePixels="True"
                            ToolTip="{loc:Loc StatusBar_AddLinks_ToolTip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgHeaderBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource AccentBlueBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:Loc StatusBar_AddLinks_Text}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Live Disk Space Box -->
                    <Border Background="{DynamicResource BgCardAltBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="10,0" 
                            Height="28" 
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconHardDrive}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FreeDiskSpaceText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                            <!-- Warning Badge if requirement exceeds free disk space -->
                            <Border Background="#25EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                    Visibility="{Binding IsDiskSpaceWarning, Converter={StaticResource BoolToVisConverter}}"
                                    ToolTip="{Binding DiskSpaceWarningMessage}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconWarning}" Fill="#EF4444" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,3,0" />
                                    <TextBlock Text="{loc:Loc StatusBar_DiskSpaceWarning}" FontSize="10" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Section: Extensions folder + Settings Button + Popup -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Open extensions folder -->
                    <Button Command="{Binding OpenExtensionsFolderCommand}"
                            Width="32" Height="28" Padding="0" Margin="0,0,8,0"
                            Background="{DynamicResource BgCardAltBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            Cursor="Hand"
                            SnapsToDevicePixels="True"
                            ToolTip="{loc:Loc StatusBar_OpenExtensionsFolder_ToolTip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource TextSecondaryBrush}"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>

                    <Button x:Name="QuickSettingsButton" 
                            Height="28"
                            Padding="10,0" 
                            Background="{DynamicResource BgCardAltBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            Margin="0"
                            Cursor="Hand"
                            SnapsToDevicePixels="True"
                            ToolTip="{loc:Loc StatusBar_Settings_ToolTip}"
                            PreviewMouseDown="QuickSettingsButton_PreviewMouseDown"
                            Click="QuickSettingsButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="4" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSliders}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <Path Data="M 0,3.5 L 3.5,0 L 7,3.5" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="7" Height="4" Stretch="Uniform" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Quick Settings Popup Component -->
                    <views:QuickSettingsPopupView x:Name="QuickSettingsPopup"
                                                  PlacementTarget="{Binding ElementName=QuickSettingsButton}" />
                </StackPanel>

                <!-- Center Section: Search Bar & Status Filter Dropdown Popup (fills remaining space with equal margins) -->
                <Grid Margin="8,0" 
                      VerticalAlignment="Center"
                      Visibility="{Binding SelectedMainTab, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Downloads'}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box (stretches to fill remaining space) -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgCardAltBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Height="28" 
                            MinWidth="120"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" 
                                  Data="{StaticResource IconSearch}" 
                                  Fill="{DynamicResource TextSecondaryBrush}" 
                                  Width="12" Height="12" 
                                  Stretch="Uniform" 
                                  VerticalAlignment="Center" 
                                  Margin="9,0,6,0" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <!-- Placeholder Watermark -->
                                <TextBlock Text="{loc:Loc Filter_Search_Placeholder}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           FontSize="11.5" 
                                           VerticalAlignment="Center" 
                                           Margin="2,0,0,0"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding HasSearchFilterText, Converter={StaticResource InverseBoolToVisConverter}}" />

                                <!-- Search Text Box -->
                                <TextBox x:Name="BottomSearchFilterBox"
                                         Text="{Binding SearchFilterText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" 
                                         Foreground="{DynamicResource TextPrimaryBrush}" 
                                         CaretBrush="{DynamicResource TextPrimaryBrush}" 
                                         BorderThickness="0" 
                                         FontSize="11.5" 
                                         VerticalAlignment="Center" 
                                         Padding="2,0" />
                            </Grid>

                            <!-- Clear Button -->
                            <Button Grid.Column="2" 
                                    Command="{Binding ClearSearchFilterCommand}"
                                    Focusable="False" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Padding="0" 
                                    Margin="0,0,6,0"
                                    Cursor="Hand" 
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasSearchFilterText, Converter={StaticResource BoolToVisConverter}}"
                                    ToolTip="{loc:Loc Filter_Clear_ToolTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="2">
                                            <Path Data="{StaticResource IconClose}" 
                                                  Fill="{DynamicResource TextSecondaryBrush}" 
                                                  Width="10" Height="10" 
                                                  Stretch="Uniform" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Compact Status Filter Button -->
                    <Button Grid.Column="1"
                            x:Name="StatusFilterButton" 
                            Height="28"
                            Padding="10,0" 
                            Background="{DynamicResource BgCardAltBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            SnapsToDevicePixels="True"
                            PreviewMouseDown="StatusFilterButton_PreviewMouseDown"
                            Click="StatusFilterButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Border" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="4" 
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCardAltBrush}" />
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderHighlightBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusFilterActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFilter}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusFilterActive}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBlueBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding SelectedStatusFilterText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusFilterActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Path Data="M 0,3.5 L 3.5,0 L 7,3.5" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="7" Height="4" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Popup for Status Filter -->
                    <Popup Grid.Column="1"
                           x:Name="StatusFilterPopup"
                           PlacementTarget="{Binding ElementName=StatusFilterButton}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           VerticalOffset="-12"
                           Closed="StatusFilterPopup_Closed">
                        <Border Background="{DynamicResource BgCardBrush}" 
                                BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="4" 
                                Width="140"
                                SnapsToDevicePixels="True" 
                                UseLayoutRounding="True">
                            <StackPanel>
                                <!-- All -->
                                <Button Style="{StaticResource FilterDropdownItemStyle}"
                                        Click="StatusFilterOption_Click"
                                        Command="{Binding SetStatusFilterCommand}"
                                        CommandParameter="All">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Filter_All}" FontSize="11.5" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                              Visibility="{Binding SelectedStatusFilter, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='All'}" />
                                    </Grid>
                                </Button>

                                <!-- Running -->
                                <Button Style="{StaticResource FilterDropdownItemStyle}"
                                        Click="StatusFilterOption_Click"
                                        Command="{Binding SetStatusFilterCommand}"
                                        CommandParameter="Running">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Filter_Running}" FontSize="11.5" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                              Visibility="{Binding SelectedStatusFilter, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Running'}" />
                                    </Grid>
                                </Button>

                                <!-- Paused -->
                                <Button Style="{StaticResource FilterDropdownItemStyle}"
                                        Click="StatusFilterOption_Click"
                                        Command="{Binding SetStatusFilterCommand}"
                                        CommandParameter="Paused">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Filter_Paused}" FontSize="11.5" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                              Visibility="{Binding SelectedStatusFilter, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Paused'}" />
                                    </Grid>
                                </Button>

                                <!-- Completed -->
                                <Button Style="{StaticResource FilterDropdownItemStyle}"
                                        Click="StatusFilterOption_Click"
                                        Command="{Binding SetStatusFilterCommand}"
                                        CommandParameter="Completed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Filter_Completed}" FontSize="11.5" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                              Visibility="{Binding SelectedStatusFilter, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Completed'}" />
                                    </Grid>
                                </Button>

                                <!-- Failed -->
                                <Button Style="{StaticResource FilterDropdownItemStyle}"
                                        Click="StatusFilterOption_Click"
                                        Command="{Binding SetStatusFilterCommand}"
                                        CommandParameter="Failed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Filter_Failed}" FontSize="11.5" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Data="{StaticResource IconCheck}" Fill="{DynamicResource AccentBlueBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"
                                              Visibility="{Binding SelectedStatusFilter, Converter={StaticResource EqualsToVisConverter}, ConverterParameter='Failed'}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
